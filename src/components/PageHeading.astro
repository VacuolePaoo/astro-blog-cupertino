---
interface Props {
	title: string
	label?: string | undefined
}

const { title, label } = Astro.props
---

<header class="page-meta">
	{label && <span>{label}</span>}
	<h1>{title}</h1>
</header>

<style>
	.page-meta {
		width: min(100%, 832px);
		margin: 128px auto 0;
		padding: 0 16px;
	}
	.page-meta span {
		display: block;
		color: var(--color-text-secondary);
		font-weight: 600;
	}
	.page-meta h1 {
		margin-top: 16px;
		font-size: 48px;
		font-weight: 700;
		line-height: normal;
	}
</style>
