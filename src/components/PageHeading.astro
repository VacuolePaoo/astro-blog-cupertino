---
import type { UiMessageKey } from '../types/i18n'

interface Props {
	title: string
	titleKey?: UiMessageKey | undefined
	label?: string | undefined
	labelKey?: UiMessageKey | undefined
	capitalize?: boolean | undefined
	containedOnMobile?: boolean | undefined
}

const {
	title,
	titleKey,
	label,
	labelKey,
	capitalize = false,
	containedOnMobile = false,
} = Astro.props
---

<header class:list={['page-meta', { 'contained-mobile': containedOnMobile }]}>
	{label && <span data-i18n={labelKey}>{label}</span>}
	<h1 class:list={{ capitalize }} data-i18n={titleKey}>{title}</h1>
</header>

<style>
	.page-meta {
		width: min(100%, 832px);
		margin: 128px auto 0;
		padding: 0 16px;
	}
	.page-meta span {
		display: block;
		color: var(--color-text-secondary);
		font-weight: 600;
	}
	.page-meta h1 {
		margin-top: 16px;
		font-size: 48px;
		font-weight: 700;
		line-height: normal;
	}
	.page-meta h1.capitalize {
		text-transform: capitalize;
	}
	@media (max-width: 832px) {
		.page-meta {
			width: calc(100% + 32px);
			margin-left: -16px;
		}
		.page-meta.contained-mobile {
			width: 100%;
			margin-left: 0;
		}
	}
</style>
