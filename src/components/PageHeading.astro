---
interface Props {
	title: string
	subtitle?: string | undefined
	capitalize?: boolean | undefined
	containedOnMobile?: boolean | undefined
}

const {
	title,
	subtitle,
	capitalize = false,
	containedOnMobile = false,
} = Astro.props
---

<header class:list={['page-meta', { 'contained-mobile': containedOnMobile }]}>
	{subtitle && <p class="subtitle">{subtitle}</p>}
	<h1 class:list={{ capitalize }}>{title}</h1>
</header>

<style>
	.page-meta {
		width: min(100%, 832px);
		margin: 128px auto 0;
		padding: 0 16px;
	}
	.page-meta .subtitle {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: 22px;
		font-weight: 200;
		line-height: normal;
	}
	.page-meta h1 {
		margin-top: 16px;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	.page-meta .subtitle + h1 {
		margin-top: 6px;
	}
	.page-meta h1.capitalize {
		text-transform: capitalize;
	}
	@media (max-width: 832px) {
		.page-meta {
			width: calc(100% + 32px);
			margin-left: -16px;
		}
		.page-meta.contained-mobile {
			width: 100%;
			margin-left: 0;
		}
	}
</style>
