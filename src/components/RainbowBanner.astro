---
import blogConfig from '../../blog.config'

const { rainbowBanner } = blogConfig.theme.appearance
const gradient = `linear-gradient(90deg, ${rainbowBanner.colors.join(', ')})`
---

{
	rainbowBanner.enabled && (
		<div
			class="rainbow-banner"
			hidden
			aria-hidden="true"
			data-rainbow-banner
			data-shown={rainbowBanner.shown}
			data-month={rainbowBanner.month}
			style={`--rainbow-gradient:${gradient}`}
		/>
	)
}

<script>
	function initializeRainbowBanner() {
		const banner = document.querySelector<HTMLElement>('[data-rainbow-banner]')
		if (!banner) return
		const month = Number(banner.dataset.month)
		banner.hidden = !(
			banner.dataset.shown === 'always' ||
			(banner.dataset.shown === 'auto' && new Date().getMonth() + 1 === month)
		)
	}

	initializeRainbowBanner()
	document.addEventListener('astro:page-load', initializeRainbowBanner)
</script>

<style>
	/* 6px solid stripe, then a soft eased fade below: the extra mask stops
	   approximate an ease-out curve so the glow dissipates instead of
	   tapering linearly. */
	.rainbow-banner {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 900;
		height: 48px;
		background-image: var(--rainbow-gradient);
		pointer-events: none;
		-webkit-mask-image: linear-gradient(
			to bottom,
			#000 0,
			#000 6px,
			rgb(0 0 0 / 0.5) 18px,
			rgb(0 0 0 / 0.16) 32px,
			transparent 48px
		);
		mask-image: linear-gradient(
			to bottom,
			#000 0,
			#000 6px,
			rgb(0 0 0 / 0.5) 18px,
			rgb(0 0 0 / 0.16) 32px,
			transparent 48px
		);
	}
</style>
