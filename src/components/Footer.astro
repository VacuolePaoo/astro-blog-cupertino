---
import blogConfig from '../../blog.config'
import { footerNav } from '../consts'
import { translate } from '../utils/i18n'
import {
	getNavGroupTitle,
	getNavItemLabel,
	getVisibleFooterNav,
} from '../utils/nav'

const visibleFooterNav = getVisibleFooterNav(
	footerNav,
	blogConfig.theme.search.enabled,
)
---

<footer class="site-footer">
	<div class="page-shell">
		<div class="footer-grid">
			{
				visibleFooterNav.map(group => (
					<section>
						<h2 data-i18n={group.titleKey}>{getNavGroupTitle(group)}</h2>
						<ul>
							{group.items.map(item => (
								<li>
									<a
										href={item.url}
										data-i18n={item.textKey}
										target={
											'external' in item && item.external ? '_blank' : undefined
										}
										rel={
											'external' in item && item.external
												? 'noopener noreferrer'
												: undefined
										}
									>
										{getNavItemLabel(item)}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
		<div class="footer-bottom">
			<p>
				© {new Date().getFullYear()}{' '}
				{
					blogConfig.copyright.url ? (
						<a href={blogConfig.copyright.url}>{blogConfig.copyright.name}</a>
					) : (
						blogConfig.copyright.name
					)
				}
			</p>
			{
				blogConfig.theme.footer.extraDescription && (
					<span class="footer-extra-description">
						{blogConfig.theme.footer.extraDescription}
					</span>
				)
			}
			{
				blogConfig.theme.footer.showColorSchemeToggle && (
					<div
						class="theme-switcher"
						role="group"
						aria-label={translate('footer.theme')}
						data-i18n-aria-label="footer.theme"
					>
						<button type="button" data-theme="light">
							<span data-i18n="footer.light">{translate('footer.light')}</span>
						</button>
						<button type="button" data-theme="dark">
							<span data-i18n="footer.dark">{translate('footer.dark')}</span>
						</button>
						<button type="button" data-theme="auto">
							<span data-i18n="footer.auto">{translate('footer.auto')}</span>
						</button>
					</div>
				)
			}
		</div>
	</div>
</footer>

<script>
	import blogConfig from '../../blog.config'
	import { initializeThemeControls } from '../utils/theme'

	const initialize = () =>
		initializeThemeControls(blogConfig.theme.appearance.colorScheme)
	initialize()
	document.addEventListener('astro:page-load', initialize)
</script>

<style>
	.site-footer {
		margin-top: 0;
		border-top: 1px solid var(--color-border-primary);
		background: var(--color-background-underlying);
		user-select: none;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding: 32px 0 0;
	}
	.footer-grid section {
		margin-bottom: 16px;
		user-select: none;
	}
	.footer-grid h2 {
		margin: 0 0 8px;
		font-size: 17px;
		font-weight: 700;
	}
	.footer-grid ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-grid a {
		color: var(--color-text-secondary);
		font-size: 16px;
		display: block;
	}
	.footer-bottom {
		padding: 0 0 32px;
		color: var(--color-text-secondary);
		font-size: 16px;
	}
	.footer-bottom p {
		margin: 0;
	}
	.footer-extra-description {
		display: block;
		margin-top: 12px;
		margin-bottom: -12px;
		color: var(--color-text-secondary);
		font-size: 14px;
	}
	.theme-switcher {
		display: flex;
		width: max-content;
		gap: 1px;
		margin-top: 16px;
		border: 1px solid var(--color-background-accent);
		border-radius: 999px;
		padding: 1px;
	}
	.theme-switcher button {
		display: block;
		width: 44px;
		height: 22px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		padding: 4px 2px;
		color: var(--color-background-accent);
		font-size: 12px;
		line-height: 14px;
		text-align: center;
		cursor: pointer;
	}
	.theme-switcher button[aria-pressed='true'] {
		background: var(--color-background-accent);
		color: var(--color-background-accent-contrast);
	}
	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 400px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
