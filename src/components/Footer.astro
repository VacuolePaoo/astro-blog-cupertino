---
import { Monitor, Moon, Sun } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { footerNav } from '../consts'
---

<footer class="site-footer">
	<div class="page-shell">
		<div class="footer-grid">
			{
				footerNav.map(group => (
					<section>
						<h2>{group.title}</h2>
						<ul>
							{group.items.map(item => (
								<li>
									<a
										href={item.url}
										target={item.external ? '_blank' : undefined}
										rel={item.external ? 'noopener noreferrer' : undefined}
									>
										{item.text}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
		<div class="footer-bottom">
			<p>
				© {new Date().getFullYear()}{' '}
				{
					blogConfig.copyright.url ? (
						<a href={blogConfig.copyright.url}>{blogConfig.copyright.name}</a>
					) : (
						blogConfig.copyright.name
					)
				}
			</p>
			<div class="theme-switcher" role="group" aria-label="主题">
				<button type="button" data-theme="light">
					<Sun size={12} aria-hidden="true" />
					<span>亮色</span>
				</button>
				<button type="button" data-theme="dark">
					<Moon size={12} aria-hidden="true" />
					<span>暗色</span>
				</button>
				<button type="button" data-theme="auto">
					<Monitor size={12} aria-hidden="true" />
					<span>自动</span>
				</button>
			</div>
		</div>
	</div>
</footer>

<script>
	import blogConfig from '../../blog.config'
	import { initializeThemeControls } from '../utils/theme'

	const initialize = () => initializeThemeControls(blogConfig.theme.colorScheme)
	initialize()
	document.addEventListener('astro:page-load', initialize)
</script>

<style>
	.site-footer {
		margin-top: 0;
		border-top: 1px solid var(--color-border-primary);
		background: var(--color-background-underlying);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding: 32px 0 0;
	}
	.footer-grid section {
		margin-bottom: 16px;
		user-select: none;
	}
	.footer-grid h2 {
		margin: 0 0 8px;
		font-size: 17px;
		font-weight: 700;
	}
	.footer-grid ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-grid a {
		color: var(--color-text-secondary);
		font-size: 16px;
		display: block;
	}
	.footer-grid a:hover {
		color: var(--color-text-secondary-hover);
	}
	.footer-bottom {
		padding: 0 0 32px;
		color: var(--color-text-secondary);
		font-size: 16px;
	}
	.footer-bottom p {
		margin: 0;
	}
	.theme-switcher {
		display: inline-flex;
		gap: 1px;
		margin-top: 16px;
		border: 1px solid var(--color-background-accent);
		border-radius: 999px;
		padding: 1px;
	}
	.theme-switcher button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		padding: 4px 8px;
		color: var(--color-background-accent);
		font-size: 12px;
		line-height: 1;
		cursor: pointer;
	}
	.theme-switcher button:hover {
		background: var(--color-background-secondary-hover);
	}
	.theme-switcher button[aria-pressed='true'] {
		background: var(--color-background-accent);
		color: var(--color-background-accent-contrast);
	}
	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 400px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
