---
import type { WorkEntry } from '../../types/work'
import { getWorkDomId } from '../../utils/work'
import ArticleCover from '../ArticleCover.astro'

interface Props {
	work: WorkEntry
}

const { work } = Astro.props
const domId = getWorkDomId(work)
---

<article class="work-card" data-work-card={domId}>
	<button
		class="work-card-hit"
		type="button"
		aria-haspopup="dialog"
		aria-label={`查看作品「${work.data.title}」`}
	>
		<span class="work-card-inner">
			{
				work.data.cover && (
					<span class="work-card-media">
						<ArticleCover
							src={work.data.cover}
							alt={`${work.data.title} 封面`}
						/>
					</span>
				)
			}
			<span class="work-card-copy">
				<span class="work-card-meta">
					<span class="work-card-category">{work.data.category}</span>
					{
						work.data.badge && (
							<span class="work-card-badge">{work.data.badge}</span>
						)
					}
				</span>
				<span class="work-card-title">
					{work.data.title}
				</span>
				<span class="work-card-excerpt">{work.data.description}</span>
			</span>
		</span>
	</button>
</article>

<style>
	.work-card {
		min-width: 0;
		user-select: none;
		overflow: hidden;
		border-radius: var(--radius-xlarge);
		background: var(--color-background-secondary);
	}
	.work-card-hit {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		margin: 0;
		padding: 0;
		text-align: left;
		font: inherit;
		color: var(--color-text-primary);
		background: transparent;
		cursor: pointer;
	}
	.work-card-hit:focus-visible {
		outline: 2px solid var(--color-text-accent);
		outline-offset: 2px;
	}
	.work-card-inner {
		display: block;
		height: 100%;
	}
	.work-card-media {
		display: block;
		height: 266px;
		overflow: hidden;
		border-radius: 0;
	}
	.work-card-media :global(picture),
	.work-card-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.work-card-media :global(img) {
		object-fit: cover;
		transition:
			scale 400ms cubic-bezier(0.4, 0, 0.25, 1),
			filter 400ms cubic-bezier(0.4, 0, 0.25, 1);
	}
	.work-card-hit:hover .work-card-media :global(img),
	.work-card-hit:focus-visible .work-card-media :global(img) {
		scale: 1.03;
		filter: brightness(0.85);
	}
	.work-card-hit:active .work-card-media :global(img) {
		scale: 1;
		filter: brightness(0.65);
	}
	.work-card-copy {
		display: block;
		padding: 32px;
	}
	.work-card-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 10px;
	}
	.work-card-category {
		display: inline-block;
		color: var(--color-text-accent);
		font-size: 12px;
		font-weight: 600;
		line-height: normal;
		text-transform: uppercase;
	}
	.work-card-badge {
		display: inline-block;
		border-radius: var(--radius-full);
		background: var(--color-background-accent-lite);
		padding: 2px 10px;
		color: var(--color-text-accent);
		font-size: 12px;
		font-weight: 600;
		line-height: normal;
	}
	.work-card-title {
		display: block;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: 1.16667;
		color: var(--color-text-primary);
		max-height: 7em;
		overflow: hidden;
	}
	.work-card-excerpt {
		display: -webkit-box;
		margin-top: 14px;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		color: var(--color-text-tertiary);
		font-size: 15px;
		font-weight: 400;
	}
	@media (max-width: 600px) {
		.work-card-copy {
			padding: 24px;
			font-size: 12px;
		}
	}
</style>
