---
import type { ArticleEntry } from '../types/article'
import type { TaxonomyKind, TaxonomySummary } from '../types/taxonomy'
import blogConfig from '../../blog.config'
import Layout from '../layouts/Layout.astro'
import { translate, translateWithValues } from '../utils/i18n'
import { getTaxonomyUrl } from '../utils/taxonomy'
import ArchiveList from './ArchiveList.astro'
import PageHeading from './PageHeading.astro'
import Pagination from './Pagination.astro'

interface Props {
	kind: TaxonomyKind
	summary: TaxonomySummary
	page: { items: ArticleEntry[]; currentPage: number; totalPages: number }
}

const { kind, summary, page } = Astro.props
const labelKey = kind === 'categories' ? 'article.category' : 'article.tag'
const label = translate(labelKey)
const title =
	kind === 'tags' && blogConfig.theme.content.tags.hashtagPrefix
		? `#${summary.name}`
		: summary.name
const descriptionKey =
	kind === 'categories' ? 'page.categoryDescription' : 'page.tagDescription'
const description = translateWithValues(descriptionKey, { name: summary.name })
---

<Layout
	title={page.currentPage === 1
		? title
		: translateWithValues('page.pageNumber', { title, page: page.currentPage })}
	titleKey={page.currentPage === 1 ? undefined : 'page.pageNumber'}
	titleValues={{ title, page: page.currentPage }}
	description={description}
	descriptionKey={descriptionKey}
	descriptionValues={{ name: summary.name }}
>
	<div class="page-shell">
		<PageHeading
			title={title}
			label={label}
			labelKey={labelKey}
			capitalize={kind === 'tags' && blogConfig.theme.content.tags.capitalize}
		/>
		<ArchiveList articles={page.items} />
		<Pagination
			current={page.currentPage}
			total={page.totalPages}
			basePath={getTaxonomyUrl(kind, summary.name)}
		/>
	</div>
</Layout>
