---
import { translate } from '../utils/i18n'
import { getPaginatedUrl, getPaginationItems } from '../utils/pagination'

interface Props {
	current: number
	total: number
	basePath?: string
}

const { current, total, basePath = '/' } = Astro.props
const items = getPaginationItems(current, total)
---

{
	total > 1 && (
		<nav
			class="pagination"
			aria-label={translate('pagination.label')}
			data-i18n-aria-label="pagination.label"
		>
			{current > 1 && (
				<a
					class="page-control prev"
					href={getPaginatedUrl(basePath, current - 1)}
				>
					<span data-i18n="pagination.previous">
						{translate('pagination.previous')}
					</span>
				</a>
			)}
			{items.map(item =>
				item.type === 'ellipsis' ? (
					<span class="page-ellipsis" aria-hidden="true">
						…
					</span>
				) : item.page === current ? (
					<span class="page-number current" aria-current="page">
						{item.page}
					</span>
				) : (
					<a class="page-number" href={getPaginatedUrl(basePath, item.page!)}>
						{item.page}
					</a>
				),
			)}
			{current < total && (
				<a
					class="page-control next"
					href={getPaginatedUrl(basePath, current + 1)}
				>
					<span data-i18n="pagination.next">
						{translate('pagination.next')}
					</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: block;
		margin: 32px 8px;
		text-align: center;
	}
	.pagination a,
	.page-ellipsis,
	.page-number.current {
		display: inline-flex;
		user-select: none;
		height: 32px;
		align-items: center;
		border-radius: var(--radius-small);
		padding: 0 12px;
		color: var(--color-text-primary);
		--radius-full: 16px;
		transition:
			background-color 200ms,
			color 200ms;
	}
	.pagination a:hover,
	.pagination a:focus-visible,
	.page-ellipsis:hover,
	.page-ellipsis:focus-visible {
		background: var(--color-background-primary-hover);
		color: var(--color-text-primary-hover);
		text-decoration: none;
	}
	.pagination a:active,
	.page-ellipsis:active {
		background: var(--color-background-primary-active);
		color: var(--color-text-primary-active);
	}
	.pagination .page-number[aria-current='page'] {
		color: var(--color-text-secondary);
	}
	.pagination .page-number[aria-current='page']:hover {
		background: transparent;
	}
	.pagination a.prev {
		padding-left: 14px;
		border-top-left-radius: var(--radius-full);
		border-bottom-left-radius: var(--radius-full);
	}
	.pagination a.next {
		padding-right: 14px;
		border-top-right-radius: var(--radius-full);
		border-bottom-right-radius: var(--radius-full);
	}
</style>
