---
import { getHomePageUrl, getPaginationItems } from '../utils/pagination'

interface Props {
	current: number
	total: number
}

const { current, total } = Astro.props
const items = getPaginationItems(current, total)
---

{
	total > 1 && (
		<nav class="pagination" aria-label="文章分页">
			{current > 1 && (
				<a class="page-control" href={getHomePageUrl(current - 1)}>
					上一页
				</a>
			)}
			{items.map(item =>
				item.type === 'ellipsis' ? (
					<span class="page-ellipsis" aria-hidden="true">
						…
					</span>
				) : (
					<a
						class="page-number"
						href={getHomePageUrl(item.page!)}
						aria-current={item.page === current ? 'page' : undefined}
					>
						{item.page}
					</a>
				),
			)}
			{current < total && (
				<a class="page-control" href={getHomePageUrl(current + 1)}>
					下一页
				</a>
			)}
		</nav>
	)
}

<style>
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		margin-top: 48px;
	}
	.pagination a,
	.page-ellipsis {
		color: var(--color-muted);
		font-size: 16px;
		font-weight: 400;
	}
	.pagination a:hover {
		color: var(--color-foreground);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.pagination a[aria-current='page'] {
		color: var(--color-muted);
	}
	.page-control {
		min-width: max-content;
	}
</style>
