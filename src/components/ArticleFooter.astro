---
import type { ArticleEntry } from '../types/article'
import { Tags } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { getArticleUrl } from '../utils/article'
import { translate, translateWithValues } from '../utils/i18n'
import { getTaxonomyUrl } from '../utils/taxonomy'

interface Props {
	article: ArticleEntry
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, newer, older, preview = false } = Astro.props
const copyright = article.data.copyright
const author = copyright?.author ?? blogConfig.author.name
const licenseName = copyright?.license ?? blogConfig.license.name
const licenseUrl = copyright?.licenseUrl ?? blogConfig.license.url
---

<footer class="article-footer">
	{
		article.data.about !== false && (
			<section class="copyright-card">
				<h2 data-i18n="article.about">{translate('article.about')}</h2>
				<div class="copyright-details">
					<span
						data-i18n-template="article.licenseBefore"
						data-i18n-value-author={author}
						>{translateWithValues('article.licenseBefore', { author })}</span
					>
					{licenseUrl ? <a href={licenseUrl}>{licenseName}</a> : licenseName}<span
						data-i18n="article.licenseEnd"
						>{translate('article.licenseEnd')}</span
					>
				</div>
				{
					article.data.tags?.length && (
						<div
							class:list={[
								'article-tags',
								{ 'capitalize-tags': blogConfig.theme.content.tags.capitalize },
							]}
							aria-label={translate('article.tags')}
							data-i18n-aria-label="article.tags"
						>
							<Tags size={14} aria-hidden="true" />
							{article.data.tags.map(tag => (
								<a href={getTaxonomyUrl('tags', tag)}>
									{blogConfig.theme.content.tags.hashtagPrefix ? '#' : ''}
									{tag}
								</a>
							))}
						</div>
					)
				}
				{article.data.extra_info && (
					<div class="extra-info">{article.data.extra_info}</div>
				)}
			</section>
		)
	}

	<nav
		class="article-surround"
		aria-label={translate('article.surround')}
		data-i18n-aria-label="article.surround"
	>
		{
			older ? (
				<a class="next" href={getArticleUrl(older, preview)}>
					<span data-i18n="article.next">{translate('article.next')}</span>
					<strong>{older.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
		{
			newer ? (
				<a class="prev" href={getArticleUrl(newer, preview)}>
					<span data-i18n="article.previous">
						{translate('article.previous')}
					</span>
					<strong>{newer.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
	</nav>
</footer>

<style>
	.article-footer {
		margin-top: 64px;
	}
	.copyright-card {
		max-width: var(--article-max);
		margin: 0 auto 64px;
		border-radius: var(--radius-medium);
		background: var(--color-background-secondary);
		padding: 16px;
	}
	.copyright-card h2 {
		margin: 0 0 16px;
		font-size: 24px;
		font-weight: 700;
		line-height: normal;
	}
	.copyright-details {
		margin: 0 0 16px;
		color: var(--color-text-primary);
		font-size: 16px;
		font-weight: 400;
		line-height: normal;
	}
	.copyright-card a {
		color: var(--color-accent);
	}
	.extra-info {
		margin-top: 12px;
		color: var(--color-text-secondary);
		font-size: 14px;
		line-height: normal;
	}
	.article-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px 6px;
		margin-top: 0;
		color: var(--color-text-primary);
		font-size: 14px;
		line-height: 20px;
		margin-bottom: 0;
	}
	.article-tags a {
		display: inline-flex;
		align-items: center;
		min-height: 20px;
		color: var(--color-text-accent);
		text-decoration: none;
	}
	.article-tags :global(svg) {
		margin-right: 2px;
		flex: none;
	}
	.article-tags.capitalize-tags {
		text-transform: capitalize;
	}
	.article-tags a:hover,
	.article-tags a:focus-visible {
		text-decoration: underline;
	}
	.article-surround {
		max-width: var(--article-max);
		margin-inline: auto;
		display: flex;
		justify-content: space-between;
		margin-top: 0;
		margin-bottom: 64px;
	}
	.article-surround a {
		display: flex;
		flex-direction: column;
		width: 50%;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 200ms ease;
	}
	.article-surround-spacer {
		width: 50%;
	}
	.article-surround a.prev {
		justify-content: flex-end;
		text-align: right;
	}
	.article-surround span {
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 400;
		margin-bottom: 4px;
	}
	.article-surround strong {
		font-size: 18.72px;
		font-weight: 700;
		line-height: normal;
	}
	.article-surround a:hover,
	.article-surround a:focus-visible {
		color: var(--color-text-secondary-hover);
	}
	.article-surround a.next {
		justify-content: flex-start;
		text-align: left;
	}
	@media (max-width: 800px) {
		.copyright-card {
			border-radius: 0;
		}
	}
</style>
