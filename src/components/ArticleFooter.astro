---
import type { ArticleEntry } from '../types/article'
import { Tags } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { getArticleUrl } from '../utils/article'
import { getTaxonomyUrl } from '../utils/taxonomy'

interface Props {
	article: ArticleEntry
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, newer, older, preview = false } = Astro.props
const copyright = article.data.copyright
const author = copyright?.author ?? blogConfig.author.name
const licenseName = copyright?.license ?? blogConfig.copyright.license
const licenseUrl = copyright?.licenseUrl ?? blogConfig.copyright.url
---

<footer class="article-footer">
	{
		article.data.about !== false && (
			<section class="copyright-card surface-card">
				<h2>关于本文</h2>
				<div class="copyright-details">
					<span>由 {author} 撰写，采用 </span>
					{licenseUrl ? <a href={licenseUrl}>{licenseName}</a> : licenseName}
					<span> 许可协议。</span>
				</div>
				{article.data.tags?.length && (
					<div
						class:list={[
							'article-tags',
							{ 'capitalize-tags': blogConfig.theme.content.tags.capitalize },
						]}
						aria-label="文章标签"
					>
						<Tags size={14} aria-hidden="true" />
						{article.data.tags.map(tag => (
							<a href={getTaxonomyUrl('tags', tag)}>
								{blogConfig.theme.content.tags.hashtagPrefix ? '#' : ''}
								{tag}
							</a>
						))}
					</div>
				)}
				{article.data.extra_info && (
					<div class="extra-info">{article.data.extra_info}</div>
				)}
			</section>
		)
	}

	<nav class="article-surround" aria-label="相邻文章">
		{
			older ? (
				<a class="next" href={getArticleUrl(older, preview)}>
					<span>下一篇</span>
					<strong>{older.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
		{
			newer ? (
				<a class="prev" href={getArticleUrl(newer, preview)}>
					<span>上一篇</span>
					<strong>{newer.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
	</nav>
</footer>

<style>
	.article-footer {
		margin-top: 64px;
	}
	.copyright-card {
		max-width: var(--article-max);
		margin: 0 auto 64px;
		/* Tighter radius than surface-card's default: this card is small. */
		border-radius: var(--radius-medium);
		padding: 16px;
	}
	.copyright-card h2 {
		margin: 0 0 16px;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: normal;
	}
	.copyright-details {
		margin: 0 0 16px;
		color: var(--color-text-primary);
		font-size: var(--font-size-base);
		font-weight: 400;
		line-height: normal;
	}
	.copyright-card a {
		color: var(--color-accent);
	}
	.extra-info {
		margin-top: 12px;
		color: var(--color-text-secondary);
		font-size: var(--font-size-small);
		line-height: normal;
	}
	.article-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px 6px;
		margin-top: 0;
		color: var(--color-text-primary);
		font-size: var(--font-size-small);
		line-height: 20px;
		margin-bottom: 0;
	}
	.article-tags a {
		display: inline-flex;
		align-items: center;
		min-height: 20px;
		color: var(--color-text-accent);
		text-decoration: none;
	}
	.article-tags :global(svg) {
		margin-right: 2px;
		flex: none;
	}
	.article-tags.capitalize-tags {
		text-transform: capitalize;
	}
	.article-tags a:hover,
	.article-tags a:focus-visible {
		text-decoration: underline;
	}
	.article-surround {
		max-width: var(--article-max);
		margin-inline: auto;
		display: flex;
		justify-content: space-between;
		margin-top: 0;
		margin-bottom: 64px;
	}
	.article-surround a {
		display: flex;
		flex-direction: column;
		width: 50%;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 200ms ease;
	}
	.article-surround-spacer {
		width: 50%;
	}
	.article-surround a.prev {
		justify-content: flex-end;
		text-align: right;
	}
	.article-surround span {
		color: var(--color-text-secondary);
		font-size: var(--font-size-base);
		font-weight: 400;
		margin-bottom: 4px;
	}
	.article-surround strong {
		font-size: var(--text-h4);
		font-weight: 700;
		line-height: normal;
	}
	.article-surround a:hover,
	.article-surround a:focus-visible {
		color: var(--color-text-secondary-hover);
	}
	.article-surround a.next {
		justify-content: flex-start;
		text-align: left;
	}
	@media (max-width: 800px) {
		.copyright-card {
			border-radius: 0;
		}
	}
</style>
