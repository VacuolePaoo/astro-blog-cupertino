---
import type { ArticleEntry } from '../types/article'
import { Tags } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { getArticleUrl } from '../utils/article'
import { getTaxonomyUrl } from '../utils/taxonomy'
import DateDisplay from './DateDisplay.astro'

interface Props {
	article: ArticleEntry
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, newer, older, preview = false } = Astro.props
const copyright = article.data.copyright ?? blogConfig.copyright
---

<footer class="article-footer">
	<section class="copyright-card">
		<h2>关于本文</h2>
		<strong>{article.data.title}</strong>
		<p>
			本文由 {blogConfig.author.name} 发布于{' '}
			<DateDisplay date={article.data.pubDate} mode="full" />，版权归
			{
				copyright.url ? (
					<a href={copyright.url}>{copyright.name}</a>
				) : (
					copyright.name
				)
			}{' '}
			所有。
		</p>
		{
			article.data.tags?.length && (
				<div class="article-tags" aria-label="文章标签">
					<Tags size={14} aria-hidden="true" />
					{article.data.tags.map(tag => (
						<a href={getTaxonomyUrl('tags', tag)}>#{tag}</a>
					))}
				</div>
			)
		}
	</section>

	<nav class="article-surround" aria-label="相邻文章">
		{
			older ? (
				<a class="next" href={getArticleUrl(older, preview)}>
					<span>下一篇</span>
					<strong>{older.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
		{
			newer ? (
				<a class="prev" href={getArticleUrl(newer, preview)}>
					<span>上一篇</span>
					<strong>{newer.data.title}</strong>
				</a>
			) : (
				<span class="article-surround-spacer" />
			)
		}
	</nav>
</footer>

<style>
	.article-footer {
		margin-top: 64px;
	}
	.copyright-card {
		max-width: calc(var(--article-max) - 2 * var(--page-gutter));
		margin: 0 auto 64px;
		border-radius: var(--radius-medium);
		background: var(--color-background-secondary);
		padding: 16px;
	}
	.copyright-card h2 {
		margin: 0 0 16px;
		font-size: 24px;
		font-weight: 700;
		line-height: normal;
	}
	.copyright-card strong {
		display: block;
		font-size: 16px;
		font-weight: 700;
		line-height: normal;
	}
	.copyright-card p {
		margin: 0 0 16px;
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 400;
		line-height: normal;
	}
	.copyright-card a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.article-tags {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px;
		margin-top: 0;
		color: var(--color-text-accent);
		font-size: 14px;
		margin-bottom: 0;
	}
	.article-tags a {
		color: inherit;
		text-decoration: none;
	}
	.article-tags a:hover,
	.article-tags a:focus-visible {
		text-decoration: underline;
	}
	.article-surround {
		max-width: var(--article-max);
		margin-inline: auto;
		display: flex;
		justify-content: space-between;
		margin-top: 0;
		margin-bottom: 64px;
	}
	.article-surround a {
		display: flex;
		flex-direction: column;
		width: 50%;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color 200ms ease;
	}
	.article-surround-spacer {
		width: 50%;
	}
	.article-surround a.prev {
		justify-content: flex-end;
		text-align: right;
	}
	.article-surround span {
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 400;
		margin-bottom: 4px;
	}
	.article-surround strong {
		font-size: 18.72px;
		font-weight: 700;
		line-height: normal;
	}
	.article-surround a:hover,
	.article-surround a:focus-visible {
		color: var(--color-text-secondary-hover);
	}
	.article-surround a.next {
		justify-content: flex-start;
		text-align: left;
	}
	@media (max-width: 800px) {
		.copyright-card {
			border-radius: 0;
		}
	}
</style>
