---
import blogConfig from '../../../blog.config'
import { absoluteUrl } from '../../utils/link'
import { siteOrigin } from '../../utils/site'

interface Props {
	title?: string | undefined
	description?: string | undefined
	image?: string | undefined
	canonical?: string | undefined
	noindex?: boolean | undefined
	type?: 'website' | 'article' | undefined
	pubDate?: string | undefined
}

const {
	title,
	description = blogConfig.description,
	image = '/og/site.png',
	canonical = Astro.url.pathname,
	noindex = false,
	type = 'website',
	pubDate,
} = Astro.props

const pageTitle = title ? `${title} - ${blogConfig.title}` : blogConfig.title
const canonicalUrl = absoluteUrl(canonical, siteOrigin)
const imageUrl = absoluteUrl(image, siteOrigin)
// 生成的 OG 图固定 1200x630；仅在确为 OG 图时输出尺寸声明
const ogImageSize = image.startsWith('/og/')
	? { width: 1200, height: 630 }
	: undefined
const imageAlt = title ?? blogConfig.title
const ogLocale = blogConfig.language.replace('-', '_')
const structuredData =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				image: imageUrl,
				datePublished: pubDate,
				dateModified: pubDate,
				mainEntityOfPage: canonicalUrl,
				author: { '@type': 'Person', name: blogConfig.author.name },
				publisher: {
					'@type': 'Organization',
					name: blogConfig.title,
					logo: {
						'@type': 'ImageObject',
						url: absoluteUrl(blogConfig.author.avatar, siteOrigin),
					},
				},
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: blogConfig.title,
				description: blogConfig.description,
				url: siteOrigin,
				inLanguage: blogConfig.language,
				author: { '@type': 'Person', name: blogConfig.author.name },
				// Sitelinks searchbox：/search/ 页面读取 ?q= 查询参数
				...(blogConfig.theme.search.enabled && {
					potentialAction: {
						'@type': 'SearchAction',
						target: {
							'@type': 'EntryPoint',
							urlTemplate: `${siteOrigin}/search/?q={search_term_string}`,
						},
						'query-input': 'required name=search_term_string',
					},
				}),
			}
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta
	name="robots"
	content={noindex
		? 'noindex, nofollow'
		: 'index, follow, max-image-preview:large'}
/>
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
{
	ogImageSize && (
		<>
			<meta property="og:image:width" content={String(ogImageSize.width)} />
			<meta property="og:image:height" content={String(ogImageSize.height)} />
		</>
	)
}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={blogConfig.title} />
<meta property="og:locale" content={ogLocale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{
	type === 'article' && pubDate && (
		<meta property="article:published_time" content={pubDate} />
	)
}
<link
	rel="alternate"
	type="application/atom+xml"
	title={`${blogConfig.title} Atom`}
	href="/atom.xml"
/>
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${blogConfig.title} RSS`}
	href="/rss.xml"
/>
<link rel="sitemap" href="/sitemap-index.xml" />
<script
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
