---
import type { TaxonomyKind, TaxonomySummary } from '../types/taxonomy'
import blogConfig from '../../blog.config'
import { getTaxonomyUrl } from '../utils/taxonomy'

interface Props {
	kind: TaxonomyKind
	items: TaxonomySummary[]
}

const { kind, items } = Astro.props
const { categories, tags } = blogConfig.theme.content
---

<div class:list={['taxonomy-index', `taxonomy-index--${kind}`]}>
	{
		items.map(item => (
			<a
				href={getTaxonomyUrl(kind, item.name)}
				class:list={{ 'capitalize-tags': kind === 'tags' && tags.capitalize }}
			>
				<span>
					{kind === 'tags' && tags.hashtagPrefix ? `#${item.name}` : item.name}
				</span>
				{(kind === 'tags' ? tags.showPostCount : categories.showPostCount) && (
					<span class="count">{item.count}</span>
				)}
			</a>
		))
	}
</div>

<style>
	.taxonomy-index {
		margin-top: 64px;
	}
	.taxonomy-index a {
		border: 1px solid var(--color-border-primary);
		background: var(--color-background-secondary);
		color: var(--color-text-primary);
		text-decoration: none;
		transition:
			background-color 200ms,
			color 200ms;
	}
	.taxonomy-index a:hover,
	.taxonomy-index a:focus-visible {
		background: var(--color-background-secondary-hover);
		color: var(--color-text-primary-hover);
		text-decoration: none;
	}
	.taxonomy-index--categories {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.taxonomy-index--categories a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin: 6px;
		border-radius: var(--radius-medium);
		padding: 14px 24px;
		font-size: var(--font-size-large);
		font-weight: 700;
		line-height: 1;
	}
	.taxonomy-index--categories .count {
		color: var(--color-text-secondary);
		font-size: var(--font-size-small);
		font-weight: 400;
	}
	.taxonomy-index--tags {
		display: flex;
		flex-wrap: wrap;
	}
	.taxonomy-index--tags a {
		margin: 4px;
		border-radius: var(--radius-full);
		padding: 8px 16px;
		font-size: var(--font-size-small);
		line-height: 1;
	}
	.taxonomy-index--tags .count {
		margin-left: 6px;
		color: var(--color-text-secondary);
		font-size: var(--font-size-small);
		vertical-align: middle;
	}
	.taxonomy-index--tags .capitalize-tags {
		text-transform: capitalize;
	}
	@media (max-width: 800px) {
		.taxonomy-index--categories {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
