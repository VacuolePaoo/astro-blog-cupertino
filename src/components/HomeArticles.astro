---
import type { ArticleEntry } from '../types/article'
import blogConfig from '../../blog.config'
import ArticleCard from './ArticleCard.astro'
import Pagination from './Pagination.astro'

interface Props {
	articles: ArticleEntry[]
	currentPage: number
	totalPages: number
}

const { articles, currentPage, totalPages } = Astro.props
---

{
	currentPage === 1 && (
		<section
			class:list={[
				'page-shell',
				'home-hero',
				{
					'exit-while-scroll':
						blogConfig.theme.motion.heroExitWhileScrolling.enabled,
					'with-blur':
						blogConfig.theme.motion.heroExitWhileScrolling.blurFilter,
				},
			]}
			aria-labelledby="site-introduction"
			data-scroll-hero
		>
			<p>{blogConfig.theme.content.hero.title}</p>
			<h1 id="site-introduction">
				{blogConfig.theme.content.hero.description}
			</h1>
		</section>
	)
}
<section
	class:list={[
		'page-shell',
		'home-articles',
		{ 'home-articles--not-index': currentPage > 1 },
	]}
	aria-labelledby={currentPage === 1 ? 'latest-heading' : undefined}
	aria-label={currentPage > 1 ? '最近文章' : undefined}
>
	{
		currentPage === 1 && <h2 id="latest-heading">最近文章</h2>
	}
	<div class="article-grid">
		{articles.map(article => <ArticleCard article={article} variant="grid" />)}
	</div>
	<Pagination current={currentPage} total={totalPages} />
</section>

<style>
	.home-hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		margin-top: 56px;
		padding-block: 160px;
		white-space: pre-wrap;
	}
	.home-hero p,
	.home-hero h1 {
		margin: 0;
	}
	.home-hero p {
		color: var(--color-text-secondary);
		font-size: 22px;
		font-weight: 200;
		line-height: normal;
	}
	.home-hero h1 {
		margin-top: 0;
		font-size: 20px;
		font-weight: 400;
		line-height: normal;
	}
	.home-articles {
		margin-bottom: 32px;
	}
	.home-articles--not-index {
		margin-top: 100px;
	}
	.home-articles > h2 {
		margin: 0.67em 0 24px;
		font-size: var(--text-section-title);
		font-weight: 700;
		line-height: 1.125;
		color: var(--color-text-primary);
	}
	.article-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px 16px;
	}
	@media (max-width: 600px) {
		.home-hero {
			padding-block: 160px;
		}
		.article-grid {
			grid-template-columns: 1fr;
			gap: 20px 16px;
			max-width: 366px;
			margin-inline: auto;
		}
	}
	@supports (animation-timeline: scroll()) {
		.home-hero.exit-while-scroll {
			--hero-scroll-range: calc(var(--current-hero-height) * 0.5px);
			will-change: filter, opacity, transform;
			animation: hero-exit linear both;
			animation-timeline: scroll() !important;
			animation-range: 0 var(--hero-scroll-range);
			transform-origin: left top;
		}
		.home-hero.exit-while-scroll.with-blur {
			animation-name: hero-exit-with-blur;
		}
		@keyframes hero-exit {
			to {
				opacity: 0;
				transform: translateY(-24px) scale(0.96);
			}
		}
		@keyframes hero-exit-with-blur {
			to {
				filter: var(--filter-blur);
				opacity: 0;
				transform: translateY(-24px) scale(0.96);
			}
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.home-hero.exit-while-scroll {
			animation: none !important;
			opacity: 1;
			filter: none;
			transform: none;
		}
	}
</style>

<script>
	function updateHeroHeight() {
		const hero = document.querySelector<HTMLElement>('[data-scroll-hero]')
		if (!hero) return
		hero.style.setProperty('--current-hero-height', String(hero.clientHeight))
	}
	updateHeroHeight()
	window.addEventListener('resize', updateHeroHeight)
	document.addEventListener('astro:page-load', updateHeroHeight)
</script>
