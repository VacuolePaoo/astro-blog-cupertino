---
import type { ArticleEntry } from '../types/article'
import blogConfig from '../../blog.config'
import ArticleCard from './ArticleCard.astro'
import Pagination from './Pagination.astro'

interface Props {
	articles: ArticleEntry[]
	currentPage: number
	totalPages: number
}

const { articles, currentPage, totalPages } = Astro.props
---

{
	currentPage === 1 && (
		<section
			class="page-shell home-hero exit-while-scroll"
			aria-labelledby="site-introduction"
			data-scroll-hero
		>
			<p>{blogConfig.title}</p>
			<h1 id="site-introduction">{blogConfig.subtitle}</h1>
		</section>
	)
}
<section class="page-shell home-articles" aria-labelledby="latest-heading">
	<h2 id="latest-heading">最近文章</h2>
	<div class="article-grid">
		{articles.map(article => <ArticleCard article={article} variant="grid" />)}
	</div>
	<Pagination current={currentPage} total={totalPages} />
</section>

<style>
	.home-hero {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 6px;
		padding-block: 160px;
		white-space: pre-wrap;
	}
	.home-hero p,
	.home-hero h1 {
		max-width: 680px;
		margin: 0;
	}
	.home-hero p {
		color: var(--color-text-secondary);
		font-size: 22px;
		font-weight: 200;
		line-height: normal;
	}
	.home-hero h1 {
		margin-top: 0;
		font-size: 20px;
		font-weight: 400;
		line-height: normal;
	}
	.home-articles {
		margin-bottom: 32px;
	}
	.home-articles > h2 {
		margin: 0 0 24px;
		font-size: var(--text-section-title);
		font-weight: 700;
		line-height: 1.125;
		color: var(--color-text-primary);
	}
	.article-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px 16px;
	}
	@media (max-width: 600px) {
		.home-hero {
			padding-block: 160px;
		}
		.home-articles {
			margin-bottom: 24px;
		}
		.article-grid {
			grid-template-columns: 1fr;
			gap: 20px 16px;
			max-width: 366px;
			margin-inline: auto;
		}
	}
	@supports (animation-timeline: scroll()) {
		.home-hero.exit-while-scroll {
			--hero-scroll-range: calc(var(--current-hero-height) * 0.5px);
			will-change: margin-top, margin-bottom, opacity, scale;
			animation: hero-exit linear both;
			animation-timeline: scroll();
			animation-range: 0 var(--hero-scroll-range);
			transform-origin: left -100%;
		}
		.home-hero.exit-while-scroll.with-blur {
			animation-name: hero-exit-with-blur;
		}
		@keyframes hero-exit {
			from {
				margin-top: 56px;
			}
			to {
				margin-top: calc(var(--hero-scroll-range) + 56px);
				margin-bottom: calc(-1 * var(--hero-scroll-range));
				opacity: 0;
				scale: 0.9;
			}
		}
		@keyframes hero-exit-with-blur {
			from {
				margin-top: 56px;
			}
			to {
				margin-top: calc(var(--hero-scroll-range) + 56px);
				margin-bottom: calc(-1 * var(--hero-scroll-range));
				filter: var(--filter-blur);
				opacity: 0;
				scale: 0.9;
			}
		}
	}
</style>

<script>
	function updateHeroHeight() {
		const hero = document.querySelector<HTMLElement>('[data-scroll-hero]')
		if (!hero) return
		hero.style.setProperty('--current-hero-height', String(hero.clientHeight))
	}
	updateHeroHeight()
	window.addEventListener('resize', updateHeroHeight)
	document.addEventListener('astro:page-load', updateHeroHeight)
</script>
