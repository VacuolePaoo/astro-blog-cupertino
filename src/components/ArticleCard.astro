---
import type { ArticleEntry } from '../types/article'
import { getArticleUrl, getCoverAlt } from '../utils/article'
import ArticleCover from './ArticleCover.astro'
import DateDisplay from './DateDisplay.astro'

interface Props {
	article: ArticleEntry
	variant?: 'featured' | 'grid' | 'archive'
	preview?: boolean
}

const { article, variant = 'grid', preview = false } = Astro.props
const href = getArticleUrl(article, preview)
const collectionUrl = `/posts/?collection=${encodeURIComponent(article.data.collection)}`
---

<article
	class:list={[
		'article-card',
		`article-card--${variant}`,
		{ 'article-card--no-cover': !article.data.cover },
	]}
>
	{
		article.data.cover && (
			<a
				class="article-card-media"
				href={href}
				aria-label={`阅读《${article.data.title}》`}
			>
				<ArticleCover
					src={article.data.cover}
					alt={getCoverAlt(article)}
					eager={variant === 'featured'}
				/>
			</a>
		)
	}
	<div class="article-card-copy">
		<a class="article-collection" href={collectionUrl}
			>{article.data.collection}</a
		>
		<h2><a class="article-card-title" href={href}>{article.data.title}</a></h2>
		<div class="article-card-date">
			<DateDisplay date={article.data.pubDate} />
		</div>
	</div>
</article>

<style>
	.article-card {
		min-width: 0;
	}
	.article-card-media {
		display: block;
		overflow: hidden;
		border-radius: inherit;
		background: var(--color-surface);
	}
	.article-card-media :global(picture),
	.article-card-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.article-card-media :global(img) {
		object-fit: cover;
		transition:
			filter 180ms ease,
			transform 180ms ease;
	}
	.article-card-media:hover :global(img) {
		filter: brightness(0.85);
		transform: scale(1.03);
	}
	.article-card-copy {
		padding: 32px;
	}
	.article-collection {
		display: inline-block;
		margin-bottom: 6px;
		color: var(--color-accent);
		font-size: 11px;
		font-weight: 600;
		line-height: normal;
		text-transform: uppercase;
	}
	.article-collection:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	h2 {
		margin: 0;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: 1.16667;
	}
	.article-card-title:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.15em;
	}
	.article-card-date {
		margin-top: 12px;
		color: var(--color-muted);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.28577;
	}
	.article-card--grid,
	.article-card--featured {
		overflow: hidden;
		min-height: 408px;
		border-radius: var(--radius-card);
		background: var(--color-card);
	}
	.article-card--grid .article-card-media,
	.article-card--featured .article-card-media {
		height: 266px;
		border-radius: 0;
	}
	.article-card--grid.article-card--no-cover,
	.article-card--featured.article-card--no-cover {
		display: flex;
		align-items: flex-start;
	}
	.article-card--grid.article-card--no-cover .article-card-copy,
	.article-card--featured.article-card--no-cover .article-card-copy {
		width: 100%;
	}
	.article-card--archive {
		display: flex;
		align-items: center;
		gap: 32px;
		border-bottom: 1px solid var(--color-border);
		padding-block: 21px;
	}
	.article-card--archive .article-card-media {
		flex: 0 0 auto;
		width: clamp(180px, 20vw, 288px);
		border-radius: var(--radius-media);
	}
	.article-card--archive .article-card-media :global(img) {
		height: auto;
	}
	.article-card--archive .article-card-copy {
		padding: 0;
	}
	.article-card--archive.article-card--no-cover {
		min-height: 112px;
	}
	@media (max-width: 600px) {
		.article-card--grid,
		.article-card--featured {
			min-height: 0;
		}
		.article-card--grid .article-card-media,
		.article-card--featured .article-card-media {
			height: auto;
			aspect-ratio: 2 / 1;
		}
		.article-card-copy {
			padding: 24px;
		}
		.article-card--archive {
			gap: 20px;
			padding-block: 21px;
		}
		.article-card--archive .article-card-media {
			width: 110px;
		}
		.article-card--archive h2 {
			font-size: 24px;
			line-height: 1.16667;
		}
		.article-card--archive .article-card-copy {
			min-width: 0;
		}
		.article-card--archive.article-card--no-cover {
			min-height: 128px;
		}
	}
</style>
