---
import type { ArticleEntry } from '../types/article'
import { getArticleUrl, getCoverAlt } from '../utils/article'
import ArticleCover from './ArticleCover.astro'
import DateDisplay from './DateDisplay.astro'

interface Props {
	article: ArticleEntry
	variant?: 'featured' | 'grid' | 'archive'
	preview?: boolean
}

const { article, variant = 'grid', preview = false } = Astro.props
const href = getArticleUrl(article, preview)
---

<article
	class:list={[
		'article-card',
		`article-card--${variant}`,
		{ 'article-card--no-cover': !article.data.cover },
	]}
>
	<a
		class="article-card-link"
		href={href}
		aria-label={`阅读《${article.data.title}》`}
	>
		{
			article.data.cover && (
				<div class="article-card-media">
					<ArticleCover
						src={article.data.cover}
						alt={getCoverAlt(article)}
						eager={variant === 'featured'}
					/>
				</div>
			)
		}
		<div class="article-card-copy">
			<span class="article-collection">{article.data.collection}</span>
			<h2 class="article-card-title">{article.data.title}</h2>
			<div class="article-card-date">
				<DateDisplay date={article.data.pubDate} />
			</div>
		</div>
	</a>
</article>

<style>
	.article-card {
		min-width: 0;
		user-select: none;
	}
	.article-card-link {
		display: block;
		height: 100%;
		color: var(--color-text-primary);
		text-decoration: none;
	}
	.article-card-link:hover,
	.article-card-link:focus-visible {
		text-decoration: none;
	}
	.article-card-media {
		display: block;
		overflow: hidden;
		border-radius: inherit;
		background: var(--color-surface);
	}
	.article-card-media :global(picture),
	.article-card-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.article-card-media :global(img) {
		object-fit: cover;
		transition:
			scale 400ms cubic-bezier(0.4, 0, 0.25, 1),
			filter 400ms cubic-bezier(0.4, 0, 0.25, 1);
	}
	.article-card-link:hover .article-card-media :global(img),
	.article-card-link:focus-visible .article-card-media :global(img) {
		scale: 1.03;
		filter: brightness(0.85);
	}
	.article-card-link:active .article-card-media :global(img) {
		scale: 1;
		filter: brightness(0.65);
	}
	.article-card-copy {
		padding: 32px;
	}
	.article-collection {
		display: inline-block;
		margin-bottom: 6px;
		color: var(--color-text-accent);
		font-size: 11px;
		font-weight: 600;
		line-height: normal;
		text-transform: uppercase;
	}
	.article-card-title {
		margin: 0;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: 1.16667;
		color: var(--color-text-primary);
		max-height: 7em;
		overflow: hidden;
		overflow-wrap: anywhere;
	}
	.article-card--grid,
	.article-card--featured {
		overflow: hidden;
		border-radius: var(--radius-large);
		background: var(--color-background-secondary);
	}
	.article-card-date {
		margin-top: 12px;
		color: var(--color-text-secondary);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.28577;
	}
	.article-card--grid .article-card-media,
	.article-card--featured .article-card-media {
		height: 266px;
		border-radius: 0;
	}
	.article-card--archive {
		border-bottom: 1px solid var(--color-border);
		padding-block: 21px;
	}
	.article-card--archive .article-card-link {
		display: flex;
		align-items: center;
	}
	.article-card--archive .article-card-media {
		flex: 0 0 auto;
		width: 20vw;
		min-width: 180px;
		border-radius: var(--radius-media);
	}
	.article-card--archive .article-card-media :global(img) {
		height: auto;
	}
	.article-card--archive .article-card-media :global(picture) {
		height: auto;
	}
	.article-card--archive .article-card-copy {
		padding: 32px;
		flex: 1 1 0;
		min-width: 0;
	}
	.article-card--archive.article-card--no-cover {
		min-height: 112px;
		border-radius: 0;
	}
	@media (max-width: 600px) {
		.article-card--grid .article-card-copy {
			font-size: 12px;
		}
		.article-card--archive .article-card-media {
			min-width: 180px;
		}
		.article-card--archive .article-card-copy {
			min-width: 0;
		}
	}
</style>
