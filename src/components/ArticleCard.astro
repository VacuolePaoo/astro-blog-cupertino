---
import type { ArticleEntry } from '../types/article'
import blogConfig from '../../blog.config'
import { getArticleExcerpt, getArticleUrl, getCoverAlt } from '../utils/article'
import ArticleCover from './ArticleCover.astro'
import DateDisplay from './DateDisplay.astro'

interface Props {
	article: ArticleEntry
	variant?: 'featured' | 'grid' | 'archive'
	preview?: boolean
}

const { article, variant = 'grid', preview = false } = Astro.props
const href = getArticleUrl(article, preview)
const excerpt = blogConfig.theme.content.cards.showExcerpt
	? getArticleExcerpt(article)
	: undefined
---

<article
	class:list={[
		'article-card',
		`article-card--${variant}`,
		variant !== 'archive' && 'surface-card',
		{ 'article-card--no-cover': !article.data.cover },
	]}
>
	<a
		class="article-card-link hover-zoom"
		href={href}
		aria-label={`阅读《${article.data.title}》`}
	>
		{
			article.data.cover && (
				<div class="article-card-media media-fill">
					<ArticleCover
						src={article.data.cover}
						alt={getCoverAlt(article)}
						eager={variant === 'featured'}
					/>
				</div>
			)
		}
		<div class="article-card-copy">
			<span
				class:list={[
					'article-collection',
					{ uppercase: blogConfig.theme.content.categories.uppercase },
				]}>{article.data.collection}</span
			>
			<h2 class="article-card-title">{article.data.title}</h2>
			{
				excerpt && (
					<div class="article-card-excerpt">
						<p>{excerpt}</p>
					</div>
				)
			}
			<div class="article-card-date">
				<DateDisplay date={article.data.pubDate} />
			</div>
		</div>
	</a>
</article>

<style>
	.article-card {
		min-width: 0;
		user-select: none;
	}
	.article-card-link {
		display: block;
		height: 100%;
		color: var(--color-text-primary);
		text-decoration: none;
	}
	.article-card-link:hover,
	.article-card-link:focus-visible {
		text-decoration: none;
	}
	.article-card-media {
		display: block;
		overflow: hidden;
		border-radius: inherit;
	}
	.article-card-copy {
		padding: 32px;
	}
	.article-collection {
		display: inline-block;
		margin-bottom: 6px;
		color: var(--color-text-accent);
		font-size: 11px;
		font-weight: 600;
		line-height: normal;
	}
	.article-collection.uppercase {
		text-transform: uppercase;
	}
	.article-card-title {
		margin: 0;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: 1.16667;
		color: var(--color-text-primary);
		max-height: 7em;
		overflow: hidden;
	}
	.article-card--grid,
	.article-card--featured {
		overflow: hidden;
	}
	.article-card-date {
		margin-top: 12px;
		color: var(--color-text-secondary);
		font-size: 14px;
		font-weight: 600;
		line-height: 1.28577;
	}
	.article-card-excerpt {
		margin-top: 12px;
		color: var(--color-text-tertiary);
		font-size: 15px;
		font-weight: 400;
	}
	.article-card-excerpt p {
		margin-block: 8px;
		padding-inline: 0;
	}
	.article-card--grid .article-card-media,
	.article-card--featured .article-card-media {
		height: 266px;
		border-radius: 0;
	}
	.article-card--archive {
		border-bottom: 1px solid var(--color-border);
		padding-block: 21px;
	}
	.article-card--archive .article-card-link {
		display: flex;
	}
	.article-card--archive .article-card-media {
		flex: 0 0 auto;
		width: 20vw;
		min-width: 180px;
		border-radius: var(--radius-medium);
	}
	.article-card--archive .article-card-copy {
		padding: 32px;
		flex: 1 1 0;
		min-width: 0;
	}
	.article-card--archive.article-card--no-cover {
		min-height: 112px;
		border-radius: 0;
	}
	@media (max-width: 600px) {
		.article-card--grid .article-card-copy {
			font-size: 12px;
		}
		.article-card--archive .article-card-media {
			min-width: 180px;
		}
		.article-card--archive .article-card-copy {
			min-width: 0;
		}
	}
</style>
