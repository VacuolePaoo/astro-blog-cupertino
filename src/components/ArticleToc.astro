---
import type { MarkdownHeading } from 'astro'
import blogConfig from '../../blog.config'
import { translate } from '../utils/i18n'

interface Props {
	headings: MarkdownHeading[]
}

const visible = blogConfig.theme.content.toc.enabled
	? Astro.props.headings.filter(
			heading => heading.depth <= blogConfig.theme.content.toc.maxDepth,
		)
	: []
---

{
	visible.length > 0 && (
		<aside
			class="article-toc"
			aria-label={translate('article.toc')}
			data-i18n-aria-label="article.toc"
		>
			{visible.map(heading => (
				<p class:list={{ nested: heading.depth === 3 }}>
					<a href={`#${heading.slug}`} data-toc-link={heading.slug}>
						{heading.text.replace(/^#/, '')}
					</a>
				</p>
			))}
		</aside>
	)
}

<script>
	let tocObserver: IntersectionObserver | undefined
	function initializeToc() {
		tocObserver?.disconnect()
		const links = [
			...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
		]
		const headings = links
			.map(link => document.getElementById(link.dataset.tocLink ?? ''))
			.filter(Boolean) as HTMLElement[]
		if (!headings.length) return
		tocObserver = new IntersectionObserver(
			entries => {
				const active = entries
					.filter(entry => entry.isIntersecting)
					.sort(
						(a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
					)[0]
				if (!active) return
				links.forEach(link =>
					link.toggleAttribute(
						'aria-current',
						link.dataset.tocLink === active.target.id,
					),
				)
			},
			{ rootMargin: '-15% 0px -70% 0px' },
		)
		headings.forEach(heading => tocObserver?.observe(heading))
	}
	initializeToc()
	document.addEventListener('astro:page-load', initializeToc)
</script>

<style>
	.article-toc {
		max-width: 832px;
		margin: 0 auto;
		padding-inline: 16px;
	}
	.article-toc p {
		margin: 0;
	}
	.article-toc a {
		display: inline-block;
		border-left: 1px solid var(--color-border-primary);
		padding: 8px 0 8px 12px;
		color: var(--color-text-secondary);
		text-decoration: none;
		transition:
			color 200ms,
			border-color 200ms;
	}
	.article-toc a:hover,
	.article-toc a:focus-visible {
		border-color: var(--color-text-secondary-hover);
		color: var(--color-text-secondary-hover);
		text-decoration: none;
	}
</style>
