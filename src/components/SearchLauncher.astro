---
import { Search } from 'lucide-astro'
---

<button
	class="search-launcher"
	type="button"
	data-search-trigger
	aria-label="搜索文章"
>
	<Search size={19} strokeWidth={1.8} />
	<span class="search-key">⌘K</span>
</button>
<div id="search-root"></div>

<script>
	let mountedRoot: Element | null = null
	async function openSearch() {
		const currentRoot = document.querySelector('#search-root')
		if (currentRoot && mountedRoot !== currentRoot) {
			const { mountSearch } = await import('./search/mount')
			await mountSearch(currentRoot)
			if (!currentRoot.isConnected) {
				mountedRoot = null
				requestAnimationFrame(() => void openSearch())
				return
			}
			mountedRoot = currentRoot
		}
		window.dispatchEvent(new CustomEvent('blog:open-search'))
	}

	document.addEventListener('click', event => {
		if ((event.target as Element).closest('[data-search-trigger]'))
			void openSearch()
	})
	document.addEventListener('keydown', event => {
		if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
			event.preventDefault()
			void openSearch()
		}
	})
</script>

<style>
	.search-launcher {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.5rem;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		padding: 0.45rem 0.55rem;
		color: var(--color-muted);
		cursor: pointer;
	}
	.search-launcher:hover {
		color: var(--color-foreground);
	}
	.search-key {
		border: 1px solid var(--color-border);
		border-radius: 0.3rem;
		padding: 0.05rem 0.3rem;
		font-size: 12px;
	}
	@media (max-width: 700px) {
		.search-key {
			display: none;
		}
	}
</style>
