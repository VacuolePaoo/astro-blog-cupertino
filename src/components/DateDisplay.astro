---
import blogConfig from '../../blog.config'
import { formatDisplayDate } from '../utils/date-display'
import { resolveUiLocale } from '../utils/i18n'

interface Props {
	date: string
	mode?: 'list' | 'full'
}

const { date, mode = 'list' } = Astro.props
const locale = resolveUiLocale(blogConfig.language)
const text = formatDisplayDate(
	date,
	blogConfig.theme.content.dates.displayFormat,
	locale,
)
---

<time datetime={date} data-date={date} data-mode={mode} aria-label={text}>
	<span class="date-primary">{text}</span>
</time>
