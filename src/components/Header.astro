---
import { ExternalLink, Search } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { moreNav, primaryNav } from '../consts'
import SearchLauncher from './SearchLauncher.astro'

const blurLayers = [1, 2, 3, 4, 5, 6]
const siteLogo =
	'logo' in blogConfig && typeof blogConfig.logo === 'string'
		? blogConfig.logo
		: undefined
---

<div class="nav-mask" aria-hidden="true">
	{blurLayers.map(sharp => <div style={`--sharp:${sharp}`} />)}
</div>
<header class="site-header" data-site-header>
	<div class="page-shell header-inner">
		<a class="brand" href="/" aria-label={`${blogConfig.title} 首页`}>
			{siteLogo && <img src={siteLogo} alt="" width="28" height="28" />}
			<span>{blogConfig.title}</span>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			{
				primaryNav.map((item, index) => (
					<a href={item.url} style={`--index:${index + 1}`}>
						{item.text}
					</a>
				))
			}
			<div class="more-menu">
				<button type="button" aria-haspopup="true"> 更多 </button>
				<div class="more-panel">
					{
						moreNav.map((item, index) => (
							<a
								href={item.url}
								style={`--index:${primaryNav.length + index + 1}`}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
							>
								{item.text}
								{item.external && <ExternalLink size={13} aria-hidden="true" />}
							</a>
						))
					}
				</div>
			</div>
			<SearchLauncher />
		</nav>

		<button
			class="mobile-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="展开导航"
			data-mobile-toggle
		>
			<span class="mobile-chevron" aria-hidden="true">
				<span class="chevron-left"></span>
				<span class="chevron-right"></span>
			</span>
		</button>
	</div>

	<div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
		<nav class="page-shell mobile-menu-inner" aria-label="移动端导航">
			<a href="/" style="--index:0">首页</a>
			{
				primaryNav.map((item, index) => (
					<a href={item.url} style={`--index:${index + 1}`}>
						{item.text}
					</a>
				))
			}
			<p class="mobile-group-label">更多</p>
			{
				moreNav.map((item, index) => (
					<a
						href={item.url}
						style={`--index:${primaryNav.length + index + 1}`}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener noreferrer' : undefined}
					>
						{item.text}
						{item.external && <ExternalLink size={14} aria-hidden="true" />}
					</a>
				))
			}
			<div class="mobile-search">
				<a
					class="mobile-search-button"
					href="/search/"
					style={`--index:${primaryNav.length + moreNav.length + 1}`}
				>
					<Search size={20} />
					<span>搜索</span>
				</a>
			</div>
		</nav>
	</div>
</header>

<script>
	function setOpen(open: boolean) {
		const toggle = document.querySelector<HTMLButtonElement>(
			'[data-mobile-toggle]',
		)
		const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
		toggle?.setAttribute('aria-expanded', String(open))
		toggle?.setAttribute('aria-label', open ? '收起导航' : '展开导航')
		menu?.setAttribute('aria-hidden', String(!open))
		document.documentElement.classList.toggle('menu-open', open)
		if (open && menu) {
			const menuHeight =
				menu.querySelector<HTMLElement>('.mobile-menu-inner')?.scrollHeight
			if (menuHeight)
				document.documentElement.style.setProperty(
					'--mobile-menu-height',
					`${menuHeight}px`,
				)
		} else {
			document.documentElement.style.removeProperty('--mobile-menu-height')
		}
	}
	window.addEventListener('resize', () => {
		const isOpen =
			document
				.querySelector('[data-mobile-toggle]')
				?.getAttribute('aria-expanded') === 'true'
		if (isOpen) setOpen(true)
		if (window.innerWidth > 600) setOpen(false)
	})
	document.addEventListener('click', event => {
		if (event.defaultPrevented) return
		const target = event.target as Element
		const toggle = target.closest<HTMLButtonElement>('[data-mobile-toggle]')
		if (toggle) {
			event.preventDefault()
			setOpen(toggle.getAttribute('aria-expanded') !== 'true')
		}
		if (target.closest('[data-mobile-menu] a')) {
			setOpen(false)
		}
	})
	document.addEventListener(
		'keydown',
		event => event.key === 'Escape' && setOpen(false),
	)
	document.addEventListener('astro:before-preparation', () => setOpen(false))
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		width: 100%;
		height: var(--header-height);
		background: transparent;
		transition: height 400ms var(--ease-standard);
	}
	.nav-mask > div {
		--mask-base-height: 100px;
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 999;
		height: calc(var(--mask-base-height) / pow(1.2, calc(var(--sharp) - 1)));
		background-color: color-mix(
			in srgb,
			var(--color-background-primary) 20%,
			transparent
		);
		backdrop-filter: blur(1px);
		-webkit-mask-image: linear-gradient(to bottom, #000, transparent);
		mask-image: linear-gradient(to bottom, #000, transparent);
		pointer-events: none;
		transition:
			height 600ms cubic-bezier(0.86, 0, 0.07, 1),
			backdrop-filter 600ms cubic-bezier(0.86, 0, 0.07, 1);
	}
	.header-inner {
		position: relative;
		z-index: 1;
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 20px;
		font-weight: 500;
		color: var(--color-text-primary);
		text-decoration: none;
		transition:
			transform 200ms,
			opacity 200ms;
	}
	.brand img {
		border-radius: 0.35rem;
	}
	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0;
	}
	.desktop-nav > a,
	.more-menu > button {
		border: 0;
		border-radius: 0.45rem;
		background: transparent;
		padding: 0 16px;
		height: 48px;
		color: var(--color-muted);
		font-size: 16px;
		cursor: pointer;
		text-decoration: none;
	}
	.desktop-nav > a:hover,
	.more-menu > button:hover,
	.more-menu:focus-within > button {
		color: var(--color-text-secondary-hover);
		text-decoration: none;
	}
	.desktop-nav > a:focus-visible {
		text-decoration: none;
	}
	.more-menu {
		position: relative;
		padding: 0;
	}
	.more-panel {
		position: absolute;
		top: 100%;
		right: 0;
		display: grid;
		min-width: 11rem;
		visibility: hidden;
		border: 1px solid var(--color-border-primary);
		border-radius: var(--radius-medium);
		background: var(--color-background-secondary-translucent);
		opacity: 0;
		padding: 0.45rem;
		transform: translateY(-0.2rem);
		transition:
			opacity 200ms ease,
			transform 200ms ease,
			visibility 140ms;
		backdrop-filter: var(--filter-blur);
	}
	.more-menu:hover .more-panel,
	.more-menu:focus-within .more-panel {
		visibility: visible;
		opacity: 1;
		transform: translateY(0);
	}
	.more-panel a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-radius: 0.4rem;
		padding: 0.55rem 0.65rem;
		font-size: 16px;
		color: var(--color-text-secondary);
		text-decoration: none;
	}
	.more-panel a:hover {
		background: var(--color-background-secondary-hover);
		text-decoration: none;
	}
	.more-panel a:focus-visible {
		text-decoration: none;
	}
	.mobile-toggle,
	.mobile-menu {
		display: none;
	}

	@media (max-width: 600px) {
		.header-inner {
			display: block;
			height: 48px;
		}
		.desktop-nav {
			display: none;
		}
		.mobile-toggle {
			position: absolute;
			top: 0;
			left: 50%;
			display: grid;
			width: 3rem;
			height: 48px;
			place-items: center;
			border: 0;
			background: transparent;
			color: var(--color-text-secondary);
			cursor: pointer;
			transform: translateX(-50%);
		}
		.mobile-chevron {
			position: relative;
			display: block;
			width: 24px;
			height: 48px;
		}
		.mobile-chevron > span {
			position: absolute;
			top: 28px;
			width: 12px;
			height: 1px;
			background: currentColor;
			transition:
				transform 600ms var(--ease-standard),
				transform-origin 600ms var(--ease-standard),
				top 600ms var(--ease-standard);
		}
		.chevron-left {
			left: 0;
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 100% 100%;
		}
		.chevron-right {
			right: 0;
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 0 100%;
		}
		.mobile-toggle[aria-expanded='true'] .mobile-chevron > span {
			top: 16px;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-left {
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 100% 0;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-right {
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 0 0;
		}
		.mobile-menu {
			position: fixed;
			top: 0;
			left: 0;
			display: block;
			width: 100%;
			height: 48px;
			overflow: hidden;
			visibility: hidden;
			background: transparent;
			opacity: 0;
			transition:
				height 400ms var(--ease-standard),
				opacity 180ms ease;
		}
		.mobile-menu[aria-hidden='false'] {
			visibility: visible;
			height: var(--mobile-menu-height, 100dvh);
			opacity: 1;
		}
		.mobile-menu-inner {
			display: flex;
			flex-direction: column;
			gap: 0;
			padding-top: 48px;
			width: min(calc(100% - 32px), 980px);
			margin-inline: auto;
		}
		.brand {
			pointer-events: auto;
			transition-delay: 350ms;
		}
		.mobile-menu a {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			height: 48px;
			min-height: 48px;
			padding: 0 4px;
			color: var(--color-text-secondary);
			font-size: 16px;
			text-decoration: none;
			opacity: 0;
			transform: translateY(-10%);
			pointer-events: none;
			transition:
				transform 400ms ease,
				opacity 400ms ease,
				color 500ms ease;
		}
		.mobile-menu[aria-hidden='false'] .mobile-menu-inner > a,
		.mobile-menu[aria-hidden='false'] .mobile-search-button {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
			transition-delay: calc(var(--index, 0) * 50ms + 100ms);
		}
		.mobile-menu a:hover {
			color: var(--color-text-secondary-hover);
			text-decoration: none;
		}
		.mobile-menu a:focus-visible {
			text-decoration: none;
		}
		.mobile-group-label {
			margin: 12px 0 4px;
			color: var(--color-text-secondary);
			font-size: 14px;
			pointer-events: none;
		}
		.mobile-search {
			margin-top: 0;
		}
		.mobile-search-button {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			height: 48px;
			min-height: 48px;
			border: 0;
			background: transparent;
			padding: 0 4px;
			color: var(--color-text-secondary);
			cursor: pointer;
			opacity: 0;
			transform: translateY(-10%);
			pointer-events: none;
			transition:
				transform 400ms ease,
				opacity 400ms ease,
				color 500ms ease;
		}
		:global(.menu-open) {
			overflow: hidden;
		}
		:global(.menu-open) .nav-mask > div {
			--mask-base-height: calc(var(--mobile-menu-height, 100dvh) * 4);
			backdrop-filter: blur(36px);
		}
		:global(.menu-open) .site-header {
			height: var(--mobile-menu-height, 100dvh);
			overflow: hidden;
		}
		:global(.menu-open) .brand {
			pointer-events: none;
			transform: translateY(8px);
			opacity: 0;
			transition-delay: 0s;
		}
	}
</style>
