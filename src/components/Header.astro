---
import type { NavEntry, NavGroup } from '../types/nav'
import { ExternalLink, Search } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { nav } from '../consts'
import { getFlaggedExternalLinkProps } from '../utils/link'
import SearchLauncher from './SearchLauncher.astro'

const blurLayers = [1, 2, 3, 4, 5, 6]
const brandName = blogConfig.brand ?? blogConfig.title
const siteLogo =
	'logo' in blogConfig && typeof blogConfig.logo === 'string'
		? blogConfig.logo
		: undefined
const isNavGroup = (entry: NavEntry): entry is NavGroup => 'items' in entry
---

{
	blogConfig.theme.navigation.blurGradient && (
		<div class="nav-mask" aria-hidden="true">
			{blurLayers.map(sharp => (
				<div style={`--sharp:${sharp}`} />
			))}
		</div>
	)
}
<header
	class:list={[
		'site-header',
		{ 'site-header--solid-blur': !blogConfig.theme.navigation.blurGradient },
	]}
	data-site-header
>
	<div class="page-shell header-inner">
		<a class="brand" href="/" aria-label={`${brandName} 首页`} data-brand-home>
			{siteLogo && <img src={siteLogo} alt="" width="28" height="28" />}
			<span>{brandName}</span>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			{
				nav.map((entry, index) =>
					isNavGroup(entry) ? (
						<div class="nav-dropdown" data-nav-dropdown>
							<button
								type="button"
								aria-controls={`desktop-dropdown-panel-${index}`}
								data-nav-dropdown-toggle
							>
								{entry.title}
							</button>
							<div
								class="nav-dropdown-panel"
								id={`desktop-dropdown-panel-${index}`}
								data-nav-dropdown-panel
							>
								{entry.items.map((item, itemIndex) => (
									<a
										href={item.url}
										style={`--index:${itemIndex}`}
										{...getFlaggedExternalLinkProps(item.external)}
									>
										<span>{item.text}</span>
										{item.external && (
											<ExternalLink size={13} aria-hidden="true" />
										)}
									</a>
								))}
							</div>
						</div>
					) : (
						<a
							href={entry.url}
							{...getFlaggedExternalLinkProps(entry.external)}
						>
							{entry.text}
						</a>
					),
				)
			}
			{blogConfig.theme.search.enabled && <SearchLauncher />}
		</nav>

		<button
			class="mobile-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="展开导航"
			data-mobile-toggle
		>
			<span class="mobile-chevron" aria-hidden="true">
				<span class="chevron-left"></span>
				<span class="chevron-right"></span>
			</span>
		</button>
	</div>

	<div
		class="mobile-menu"
		id="mobile-menu"
		aria-hidden="true"
		inert
		data-mobile-menu
	>
		<nav class="page-shell mobile-menu-inner" aria-label="移动端导航">
			<a href="/" style="--index:0">首页</a>
			{
				nav.map((entry, index) =>
					isNavGroup(entry) ? (
						<div class="mobile-group" data-mobile-group data-open="false">
							<button
								type="button"
								class="mobile-group-toggle"
								aria-expanded="false"
								aria-controls={`mobile-group-panel-${index}`}
								data-mobile-group-toggle
								style={`--index:${index + 1}`}
							>
								<span>{entry.title}</span>
							</button>
							<div
								class="mobile-group-panel"
								id={`mobile-group-panel-${index}`}
								inert
								data-mobile-group-panel
							>
								{entry.items.map((item, itemIndex) => (
									<a
										href={item.url}
										style={`--index:${itemIndex}`}
										{...getFlaggedExternalLinkProps(item.external)}
									>
										<span>{item.text}</span>
										{item.external && (
											<ExternalLink size={14} aria-hidden="true" />
										)}
									</a>
								))}
							</div>
						</div>
					) : (
						<a
							href={entry.url}
							style={`--index:${index + 1}`}
							{...getFlaggedExternalLinkProps(entry.external)}
						>
							{entry.text}
						</a>
					),
				)
			}
			{
				blogConfig.theme.search.enabled && (
					<a
						class="mobile-search-button"
						href="/search/"
						aria-label="搜索文章"
						style={`--index:${nav.length + 1}`}
					>
						<Search size={24} strokeWidth={1.8} aria-hidden="true" />
					</a>
				)
			}
		</nav>
	</div>
</header>

<script>
	let pinnedDropdown: HTMLElement | null = null

	function setDropdownOpen(dropdown: HTMLElement, open: boolean) {
		const toggle = dropdown.querySelector<HTMLButtonElement>(
			'[data-nav-dropdown-toggle]',
		)
		const panel = dropdown.querySelector<HTMLElement>(
			'[data-nav-dropdown-panel]',
		)
		if (!toggle || !panel) return
		dropdown.dataset.open = String(open)
		toggle.setAttribute('aria-expanded', String(open))
		panel.inert = !open
		if (!open && pinnedDropdown === dropdown) pinnedDropdown = null
	}

	function getDropdowns() {
		return [...document.querySelectorAll<HTMLElement>('[data-nav-dropdown]')]
	}

	function closeAllDropdowns() {
		for (const dropdown of getDropdowns())
			if (dropdown.dataset.open === 'true') setDropdownOpen(dropdown, false)
		pinnedDropdown = null
	}

	// Re-runs on every astro:page-load; the data-managed guard keeps the
	// per-element listeners from being attached twice to the same node.
	function initializeDropdowns() {
		for (const dropdown of getDropdowns()) {
			if (dropdown.dataset.managed) continue
			dropdown.dataset.managed = ''
			setDropdownOpen(dropdown, false)
			dropdown.addEventListener('pointerenter', event => {
				if (event.pointerType !== 'touch') setDropdownOpen(dropdown, true)
			})
			dropdown.addEventListener('pointerleave', () => {
				if (pinnedDropdown !== dropdown) setDropdownOpen(dropdown, false)
			})
			dropdown.addEventListener('focusin', () =>
				setDropdownOpen(dropdown, true),
			)
			dropdown.addEventListener('focusout', event => {
				if (!dropdown.contains(event.relatedTarget as Node | null))
					setDropdownOpen(dropdown, false)
			})
		}
	}
	initializeDropdowns()
	document.addEventListener('astro:page-load', initializeDropdowns)

	const MOBILE_NAV_MAX_WIDTH = 600

	function isMobileLayout() {
		return window.innerWidth <= MOBILE_NAV_MAX_WIDTH
	}

	function isMenuOpen() {
		return document.documentElement.classList.contains('menu-open')
	}

	function measureOpenHeight() {
		const header = document.querySelector<HTMLElement>('[data-site-header]')
		if (!header || !isMobileLayout()) return
		document.documentElement.style.setProperty(
			'--open-height',
			`${header.scrollHeight}px`,
		)
	}

	function setMobileGroupOpen(group: HTMLElement, open: boolean) {
		const toggle = group.querySelector<HTMLButtonElement>(
			'[data-mobile-group-toggle]',
		)
		const panel = group.querySelector<HTMLElement>('[data-mobile-group-panel]')
		if (!toggle || !panel) return
		group.dataset.open = String(open)
		toggle.setAttribute('aria-expanded', String(open))
		panel.inert = !open
	}

	function closeAllMobileGroups() {
		for (const group of document.querySelectorAll<HTMLElement>(
			'[data-mobile-group]',
		))
			setMobileGroupOpen(group, false)
	}

	function setOpen(open: boolean) {
		if (open) closeAllDropdowns()
		const toggle = document.querySelector<HTMLButtonElement>(
			'[data-mobile-toggle]',
		)
		const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
		if (open) measureOpenHeight()
		document.documentElement.classList.toggle('menu-open', open)
		toggle?.setAttribute('aria-expanded', String(open))
		toggle?.setAttribute('aria-label', open ? '收起导航' : '展开导航')
		menu?.setAttribute('aria-hidden', String(!open))
		if (menu) menu.inert = !open
		if (!open) closeAllMobileGroups()
	}
	function updateBrandLabel() {
		const brand = document.querySelector<HTMLAnchorElement>('[data-brand-home]')
		if (brand)
			brand.setAttribute(
				'aria-label',
				`${brand.textContent?.trim() ?? ''} 首页`,
			)
	}
	updateBrandLabel()
	document.addEventListener('astro:page-load', updateBrandLabel)
	window.addEventListener('resize', () => {
		if (isMenuOpen()) {
			if (isMobileLayout()) measureOpenHeight()
			else setOpen(false)
		}
		if (!isMobileLayout()) closeAllDropdowns()
	})
	document.addEventListener('click', event => {
		if (event.defaultPrevented) return
		const target = event.target as Element
		const dropdownToggle = target.closest<HTMLButtonElement>(
			'[data-nav-dropdown-toggle]',
		)
		if (dropdownToggle) {
			const dropdown = dropdownToggle.closest<HTMLElement>(
				'[data-nav-dropdown]',
			)
			if (!dropdown) return
			event.preventDefault()
			if (pinnedDropdown === dropdown) {
				pinnedDropdown = null
				setDropdownOpen(dropdown, false)
			} else {
				closeAllDropdowns()
				pinnedDropdown = dropdown
				setDropdownOpen(dropdown, true)
			}
			return
		}
		if (
			target.closest('[data-nav-dropdown-panel] a') ||
			!target.closest('[data-nav-dropdown]')
		)
			closeAllDropdowns()
		if (!isMobileLayout()) return

		const groupToggle = target.closest<HTMLButtonElement>(
			'[data-mobile-group-toggle]',
		)
		if (groupToggle) {
			event.preventDefault()
			const group = groupToggle.closest<HTMLElement>('[data-mobile-group]')
			if (!group) return
			setMobileGroupOpen(
				group,
				groupToggle.getAttribute('aria-expanded') !== 'true',
			)
			return
		}
		if (target.closest('[data-mobile-menu] a')) {
			setOpen(false)
			return
		}
		if (target.closest('[data-mobile-group]')) return
		if (target.closest('[data-site-header]')) setOpen(!isMenuOpen())
	})
	document.addEventListener('keydown', event => {
		const openDropdowns = getDropdowns().filter(
			dropdown => dropdown.dataset.open === 'true',
		)
		if (event.key === 'Escape' && openDropdowns.length) {
			event.preventDefault()
			for (const dropdown of openDropdowns) setDropdownOpen(dropdown, false)
			pinnedDropdown = null
			openDropdowns[0]
				?.querySelector<HTMLButtonElement>('[data-nav-dropdown-toggle]')
				?.focus()
			return
		}
		if (
			event.key !== 'Escape' ||
			!document.documentElement.classList.contains('menu-open')
		)
			return
		setOpen(false)
		document.querySelector<HTMLButtonElement>('[data-mobile-toggle]')?.focus()
	})
	document.addEventListener('astro:before-preparation', () => {
		closeAllDropdowns()
		setOpen(false)
	})
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		width: 100%;
		height: var(--header-height);
		background: transparent;
		transition: height 400ms var(--ease-standard);
	}
	.site-header--solid-blur {
		background: var(--color-background-secondary-translucent);
		backdrop-filter: var(--filter-blur);
	}
	/* Verbatim port of the Cupertino reference nav-mask: each layer carries its
	   own background, blur and gradient mask, and menu-open transitions the blur
	   radius (1px → 36px) together with the height on that same element. */
	.nav-mask > div {
		--mask-base-height: 100px;
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		height: calc(var(--mask-base-height) / pow(1.2, calc(var(--sharp) - 1)));
		background-color: var(--color-background-primary-translucent);
		/* -webkit- first: the minifier keeps only the last of a prefix/standard
		   pair, and Chrome/Firefox ignore the -webkit- alias. */
		-webkit-backdrop-filter: blur(1px);
		backdrop-filter: blur(1px);
		-webkit-mask-image: linear-gradient(to bottom, #000, transparent);
		mask-image: linear-gradient(to bottom, #000, transparent);
		mask-composite: destination-in;
		pointer-events: none;
		transition:
			height 600ms cubic-bezier(0.86, 0, 0.07, 1),
			backdrop-filter 600ms cubic-bezier(0.86, 0, 0.07, 1);
	}
	:global(.menu-open) .nav-mask > div {
		-webkit-backdrop-filter: blur(36px);
		backdrop-filter: blur(36px);
	}
	.header-inner {
		position: relative;
		z-index: 1;
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: var(--font-size-large);
		font-weight: 500;
		color: var(--color-text-primary);
		text-decoration: none;
		transition:
			transform 200ms,
			opacity 200ms;
	}
	.brand img {
		border-radius: 0.35rem;
	}
	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0;
	}
	.desktop-nav > a,
	.nav-dropdown > button {
		display: flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: var(--radius-small);
		background: transparent;
		padding: 0 16px;
		height: 48px;
		color: var(--color-muted);
		font-size: var(--font-size-base);
		cursor: pointer;
		text-decoration: none;
	}
	.desktop-nav > a:hover,
	.nav-dropdown > button:hover,
	.nav-dropdown:focus-within > button {
		color: var(--color-text-secondary-hover);
		text-decoration: none;
	}
	.desktop-nav > a:focus-visible {
		text-decoration: none;
	}
	.nav-dropdown {
		position: relative;
		padding: 0;
	}
	.nav-dropdown-panel {
		--panel-radius: var(--radius-medium);
		--panel-padding: 0.45rem;
		position: absolute;
		top: 100%;
		right: 0;
		display: grid;
		min-width: 11rem;
		visibility: hidden;
		pointer-events: none;
		border: 1px solid var(--color-border-primary);
		border-radius: var(--panel-radius);
		/* Opaque surface like .search-field, not the translucent glass of
		   .page-top-action: the panel sits inside the fixed header, and
		   backdrop-filter on descendants of a fixed element renders nothing
		   (verified in Chromium), so translucency here only lets page content
		   interfere with the items. */
		background: var(--color-background-secondary);
		opacity: 0;
		padding: var(--panel-padding);
		transition:
			opacity 120ms cubic-bezier(0.4, 0, 1, 1),
			visibility 0s linear 180ms;
	}
	.nav-dropdown:not([data-managed]):hover .nav-dropdown-panel,
	.nav-dropdown:not([data-managed]):focus-within .nav-dropdown-panel,
	.nav-dropdown[data-open='true'] .nav-dropdown-panel {
		visibility: visible;
		pointer-events: auto;
		opacity: 1;
		transition:
			opacity 160ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s;
	}
	.nav-dropdown-panel a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		/* Inner radius follows the nested-corner rule: outer radius minus the
		   panel inset, so items track the panel through both radius scales. */
		border-radius: calc(var(--panel-radius) - var(--panel-padding));
		padding: 0.55rem 0.65rem;
		font-size: var(--font-size-base);
		color: var(--color-text-secondary);
		text-decoration: none;
		opacity: 0;
		transform: translateY(-10%);
		transition:
			opacity 150ms cubic-bezier(0.4, 0, 1, 1),
			transform 150ms cubic-bezier(0.4, 0, 1, 1);
	}
	.nav-dropdown:not([data-managed]):hover .nav-dropdown-panel a,
	.nav-dropdown:not([data-managed]):focus-within .nav-dropdown-panel a,
	.nav-dropdown[data-open='true'] .nav-dropdown-panel a {
		opacity: 1;
		transform: translateY(0);
		/* Item reveal mirrors the mobile menu: settle downward while fading
		   in over 400ms ease, staggered top to bottom. */
		transition:
			opacity 400ms ease,
			transform 400ms ease;
		transition-delay: calc(var(--index, 0) * 50ms + 100ms);
	}
	.nav-dropdown:has(:focus-visible) .nav-dropdown-panel,
	.nav-dropdown:has(:focus-visible) .nav-dropdown-panel a {
		transition: none;
	}
	.nav-dropdown-panel a:hover {
		background: var(--color-background-secondary-hover);
		text-decoration: none;
	}
	.nav-dropdown-panel a:focus-visible {
		text-decoration: none;
	}
	.mobile-toggle,
	.mobile-menu {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-dropdown .nav-dropdown-panel,
		.nav-dropdown .nav-dropdown-panel a,
		.site-header,
		.nav-mask > div,
		.brand,
		.mobile-menu a,
		.mobile-group-toggle {
			transition: none !important;
		}
	}

	@media (max-width: 600px) {
		.site-header {
			height: 48px;
			overflow: hidden;
		}
		.header-inner {
			height: 48px;
		}
		.desktop-nav {
			display: none;
		}
		.brand {
			pointer-events: none;
			transition-delay: 350ms;
		}
		.mobile-toggle {
			position: absolute;
			top: 0;
			left: 50%;
			display: grid;
			width: 3rem;
			height: 48px;
			place-items: center;
			border: 0;
			background: transparent;
			color: var(--color-text-secondary);
			cursor: pointer;
			transform: translateX(-50%);
		}
		.mobile-chevron {
			position: relative;
			display: block;
			width: 24px;
			height: 48px;
		}
		.mobile-chevron > span {
			position: absolute;
			top: 28px;
			width: 12px;
			height: 1px;
			background: currentColor;
			transition:
				transform 600ms var(--ease-standard),
				transform-origin 600ms var(--ease-standard),
				top 600ms var(--ease-standard);
		}
		.chevron-left {
			left: 0;
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 100% 100%;
		}
		.chevron-right {
			right: 0;
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 0 100%;
		}
		.mobile-toggle[aria-expanded='true'] .mobile-chevron > span {
			top: 16px;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-left {
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 100% 0;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-right {
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 0 0;
		}
		.mobile-menu {
			display: block;
			width: 100%;
		}
		.mobile-menu-inner {
			display: flex;
			width: 100%;
			flex-wrap: wrap;
		}
		.mobile-menu a,
		.mobile-group-toggle {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			height: 48px;
			padding: 0 4px;
			color: var(--color-text-secondary);
			font-size: var(--font-size-base);
			text-decoration: none;
			opacity: 0;
			transform: translateY(-10%);
			pointer-events: none;
			transition:
				transform 400ms ease,
				opacity 400ms ease,
				color 500ms ease;
		}
		.mobile-menu-inner > a:not(.mobile-search-button),
		.mobile-group {
			width: 100%;
		}
		.mobile-group {
			display: flex;
			align-items: center;
		}
		.mobile-group-toggle {
			flex: none;
			border: 0;
			background: transparent;
			text-align: left;
			cursor: pointer;
		}
		.mobile-group-panel {
			display: flex;
			min-width: 0;
			flex: 1;
			align-items: center;
			overflow-x: auto;
			overflow-y: hidden;
			pointer-events: none;
			scrollbar-width: none;
		}
		.mobile-group-panel::-webkit-scrollbar {
			display: none;
		}
		.mobile-group-panel a {
			flex: none;
			transform: translateY(50%);
		}
		.mobile-menu[aria-hidden='false'] .mobile-menu-inner > a,
		.mobile-menu[aria-hidden='false'] .mobile-group-toggle {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
			transition-delay: calc(var(--index, 0) * 50ms + 100ms);
		}
		.mobile-menu[aria-hidden='false']
			.mobile-group[data-open='true']
			.mobile-group-panel {
			pointer-events: auto;
		}
		.mobile-menu[aria-hidden='false']
			.mobile-group[data-open='true']
			.mobile-group-panel
			a {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
			transition-delay: calc(var(--index, 0) * 50ms + 100ms);
		}
		.mobile-menu a:hover {
			color: var(--color-text-secondary-hover);
			text-decoration: none;
		}
		.mobile-menu a:focus-visible {
			text-decoration: none;
		}
		:global(.menu-open) {
			overflow: hidden;
		}
		:global(.menu-open) .nav-mask > div {
			--mask-base-height: calc(var(--open-height, 100dvh) * 4);
		}
		:global(.menu-open) .site-header {
			height: var(--open-height, 100dvh);
		}
		:global(.menu-open) .brand {
			transform: translateY(8px);
			opacity: 0;
			transition-delay: 0s;
		}
	}
</style>
