---
import { ExternalLink, Search } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { moreNav, primaryNav } from '../consts'
import SearchLauncher from './SearchLauncher.astro'

const blurLayers = [1, 2, 3, 4, 5, 6]
const siteLogo =
	'logo' in blogConfig && typeof blogConfig.logo === 'string'
		? blogConfig.logo
		: undefined
---

{
	blogConfig.theme.navigation.blurGradient && (
		<div class="nav-mask" aria-hidden="true">
			{blurLayers.map(sharp => (
				<div style={`--sharp:${sharp}`} />
			))}
		</div>
	)
}
<header
	class:list={[
		'site-header',
		{ 'site-header--solid-blur': !blogConfig.theme.navigation.blurGradient },
	]}
	data-site-header
>
	<div class="page-shell header-inner">
		<a
			class="brand"
			href="/"
			aria-label={`${blogConfig.title} 首页`}
			data-brand-home
		>
			{siteLogo && <img src={siteLogo} alt="" width="28" height="28" />}
			<span>{blogConfig.title}</span>
		</a>

		<nav class="desktop-nav" aria-label="主导航">
			{
				primaryNav.map((item, index) => (
					<a href={item.url} style={`--index:${index + 1}`}>
						{item.text}
					</a>
				))
			}
			<div class="more-menu" data-desktop-more>
				<button
					type="button"
					aria-controls="desktop-more-panel"
					data-desktop-more-toggle>更多</button
				>
				<div class="more-panel" id="desktop-more-panel" data-desktop-more-panel>
					{
						moreNav.map((item, index) => (
							<a
								href={item.url}
								style={`--index:${index}`}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
							>
								<span>{item.text}</span>
								{item.external && <ExternalLink size={13} aria-hidden="true" />}
							</a>
						))
					}
				</div>
			</div>
			{blogConfig.theme.search.enabled && <SearchLauncher />}
		</nav>

		<button
			class="mobile-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="展开导航"
			data-mobile-toggle
		>
			<span class="mobile-chevron" aria-hidden="true">
				<span class="chevron-left"></span>
				<span class="chevron-right"></span>
			</span>
		</button>
	</div>

	<div
		class="mobile-menu"
		id="mobile-menu"
		aria-hidden="true"
		inert
		data-mobile-menu
	>
		<nav class="page-shell mobile-menu-inner" aria-label="移动端导航">
			<a href="/" style="--index:0">首页</a>
			{
				primaryNav.map((item, index) => (
					<a href={item.url} style={`--index:${index + 1}`}>
						{item.text}
					</a>
				))
			}
			<div class="mobile-more" data-mobile-more data-open="false">
				<button
					type="button"
					class="mobile-more-toggle"
					aria-expanded="false"
					aria-controls="mobile-more-panel"
					data-mobile-more-toggle
					style={`--index:${primaryNav.length + 1}`}
				>
					<span>更多</span>
				</button>
				<div
					class="mobile-more-panel"
					id="mobile-more-panel"
					inert
					data-mobile-more-panel
				>
					{
						moreNav.map((item, index) => (
							<a
								href={item.url}
								style={`--index:${index}`}
								target={item.external ? '_blank' : undefined}
								rel={item.external ? 'noopener noreferrer' : undefined}
							>
								<span>{item.text}</span>
								{item.external && <ExternalLink size={14} aria-hidden="true" />}
							</a>
						))
					}
				</div>
			</div>
			{
				blogConfig.theme.search.enabled && (
					<a
						class="mobile-search-button"
						href="/search/"
						aria-label="搜索文章"
						style={`--index:${primaryNav.length + 2}`}
					>
						<Search size={24} strokeWidth={1.8} aria-hidden="true" />
					</a>
				)
			}
		</nav>
	</div>
</header>

<script>
	const desktopMore = document.querySelector<HTMLElement>('[data-desktop-more]')
	let desktopMorePinned = false

	function setDesktopMoreOpen(open: boolean) {
		const toggle = desktopMore?.querySelector<HTMLButtonElement>(
			'[data-desktop-more-toggle]',
		)
		const panel = desktopMore?.querySelector<HTMLElement>(
			'[data-desktop-more-panel]',
		)
		if (!desktopMore || !toggle || !panel) return
		desktopMore.dataset.open = String(open)
		toggle.setAttribute('aria-expanded', String(open))
		panel.inert = !open
		if (!open) desktopMorePinned = false
	}

	if (desktopMore) {
		desktopMore.dataset.managed = ''
		setDesktopMoreOpen(false)
		desktopMore.addEventListener('pointerenter', event => {
			if (event.pointerType !== 'touch') setDesktopMoreOpen(true)
		})
		desktopMore.addEventListener('pointerleave', () => {
			if (!desktopMorePinned) setDesktopMoreOpen(false)
		})
		desktopMore.addEventListener('focusin', () => setDesktopMoreOpen(true))
		desktopMore.addEventListener('focusout', event => {
			if (!desktopMore.contains(event.relatedTarget as Node | null))
				setDesktopMoreOpen(false)
		})
	}

	const MOBILE_NAV_MAX_WIDTH = 600

	function isMobileLayout() {
		return window.innerWidth <= MOBILE_NAV_MAX_WIDTH
	}

	function isMenuOpen() {
		return document.documentElement.classList.contains('menu-open')
	}

	function measureOpenHeight() {
		const header = document.querySelector<HTMLElement>('[data-site-header]')
		if (!header || !isMobileLayout()) return
		document.documentElement.style.setProperty(
			'--open-height',
			`${header.scrollHeight}px`,
		)
	}

	function setMoreOpen(open: boolean) {
		const wrap = document.querySelector<HTMLElement>('[data-mobile-more]')
		const toggle = document.querySelector<HTMLButtonElement>(
			'[data-mobile-more-toggle]',
		)
		const panel = document.querySelector<HTMLElement>(
			'[data-mobile-more-panel]',
		)
		if (!wrap || !toggle || !panel) return
		wrap.dataset.open = String(open)
		toggle.setAttribute('aria-expanded', String(open))
		panel.inert = !open
	}

	function setOpen(open: boolean) {
		if (open) setDesktopMoreOpen(false)
		const toggle = document.querySelector<HTMLButtonElement>(
			'[data-mobile-toggle]',
		)
		const menu = document.querySelector<HTMLElement>('[data-mobile-menu]')
		if (open) measureOpenHeight()
		document.documentElement.classList.toggle('menu-open', open)
		toggle?.setAttribute('aria-expanded', String(open))
		toggle?.setAttribute('aria-label', open ? '收起导航' : '展开导航')
		menu?.setAttribute('aria-hidden', String(!open))
		if (menu) menu.inert = !open
		if (!open) setMoreOpen(false)
	}
	function updateBrandLabel() {
		const brand = document.querySelector<HTMLAnchorElement>('[data-brand-home]')
		if (brand)
			brand.setAttribute(
				'aria-label',
				`${brand.textContent?.trim() ?? ''} 首页`,
			)
	}
	updateBrandLabel()
	document.addEventListener('astro:page-load', updateBrandLabel)
	window.addEventListener('resize', () => {
		if (isMenuOpen()) {
			if (isMobileLayout()) measureOpenHeight()
			else setOpen(false)
		}
		if (!isMobileLayout()) setDesktopMoreOpen(false)
	})
	document.addEventListener('click', event => {
		if (event.defaultPrevented) return
		const target = event.target as Element
		const desktopToggle = target.closest<HTMLButtonElement>(
			'[data-desktop-more-toggle]',
		)
		if (desktopToggle) {
			event.preventDefault()
			if (desktopMorePinned) setDesktopMoreOpen(false)
			else {
				desktopMorePinned = true
				setDesktopMoreOpen(true)
			}
			return
		}
		if (target.closest('[data-desktop-more-panel] a')) setDesktopMoreOpen(false)
		else if (!target.closest('[data-desktop-more]')) setDesktopMoreOpen(false)
		if (!isMobileLayout()) return

		const moreToggle = target.closest<HTMLButtonElement>(
			'[data-mobile-more-toggle]',
		)
		if (moreToggle) {
			event.preventDefault()
			setMoreOpen(moreToggle.getAttribute('aria-expanded') !== 'true')
			return
		}
		if (target.closest('[data-mobile-menu] a')) {
			setOpen(false)
			return
		}
		if (target.closest('[data-mobile-more]')) return
		if (target.closest('[data-site-header]')) setOpen(!isMenuOpen())
	})
	document.addEventListener('keydown', event => {
		if (event.key === 'Escape' && desktopMore?.dataset.open === 'true') {
			event.preventDefault()
			desktopMore
				.querySelector<HTMLButtonElement>('[data-desktop-more-toggle]')
				?.focus()
			setDesktopMoreOpen(false)
			return
		}
		if (
			event.key !== 'Escape' ||
			!document.documentElement.classList.contains('menu-open')
		)
			return
		setOpen(false)
		document.querySelector<HTMLButtonElement>('[data-mobile-toggle]')?.focus()
	})
	document.addEventListener('astro:before-preparation', () => {
		setDesktopMoreOpen(false)
		setOpen(false)
	})
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		width: 100%;
		height: var(--header-height);
		background: transparent;
		transition: height 400ms var(--ease-standard);
	}
	.site-header--solid-blur {
		background: var(--color-background-secondary-translucent);
		backdrop-filter: var(--filter-blur);
	}
	/* Height animates on the wrapper only; it has no filter/mask/opacity so the
	   pseudo-layers' backdrop still reaches the page content. The blur radius
	   itself never transitions — a variable radius forces a full backdrop
	   re-filter on all layers every frame, which stutters on mobile. */
	.nav-mask > div {
		--mask-base-height: 100px;
		position: fixed;
		top: 0;
		right: 0;
		left: 0;
		z-index: 1000;
		height: calc(var(--mask-base-height) / pow(1.2, calc(var(--sharp) - 1)));
		pointer-events: none;
		transition: height 600ms cubic-bezier(0.86, 0, 0.07, 1);
	}
	.nav-mask > div::before,
	.nav-mask > div::after {
		content: '';
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(to bottom, #000, transparent);
		mask-image: linear-gradient(to bottom, #000, transparent);
		mask-composite: destination-in;
		pointer-events: none;
	}
	.nav-mask > div::before {
		background-color: color-mix(
			in srgb,
			var(--color-background-primary) 20%,
			transparent
		);
		/* -webkit- first: the minifier keeps only the last of a prefix/standard
		   pair, and Chrome/Firefox ignore the -webkit- alias. */
		-webkit-backdrop-filter: blur(1px);
		backdrop-filter: blur(1px);
	}
	.nav-mask > div::after {
		-webkit-backdrop-filter: blur(36px);
		backdrop-filter: blur(36px);
		opacity: 0;
		will-change: opacity;
		transition: opacity 600ms cubic-bezier(0.86, 0, 0.07, 1);
	}
	.header-inner {
		position: relative;
		z-index: 1;
		display: flex;
		height: 100%;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-size: 20px;
		font-weight: 500;
		color: var(--color-text-primary);
		text-decoration: none;
		transition:
			transform 200ms,
			opacity 200ms;
	}
	.brand img {
		border-radius: 0.35rem;
	}
	.desktop-nav {
		display: flex;
		align-items: center;
		gap: 0;
	}
	.desktop-nav > a,
	.more-menu > button {
		display: flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 0.45rem;
		background: transparent;
		padding: 0 16px;
		height: 48px;
		color: var(--color-muted);
		font-size: 16px;
		cursor: pointer;
		text-decoration: none;
	}
	.desktop-nav > a:hover,
	.more-menu > button:hover,
	.more-menu:focus-within > button {
		color: var(--color-text-secondary-hover);
		text-decoration: none;
	}
	.desktop-nav > a:focus-visible {
		text-decoration: none;
	}
	.more-menu {
		position: relative;
		padding: 0;
	}
	.more-panel {
		position: absolute;
		top: 100%;
		right: 0;
		display: grid;
		min-width: 11rem;
		visibility: hidden;
		pointer-events: none;
		border: 1px solid var(--color-border-primary);
		border-radius: var(--radius-medium);
		background: var(--color-background-secondary-translucent);
		opacity: 0;
		padding: 0.45rem;
		backdrop-filter: var(--filter-blur);
		clip-path: inset(0 0 100% 0 round var(--radius-medium));
		transition:
			clip-path 180ms cubic-bezier(0.4, 0, 1, 1),
			opacity 120ms cubic-bezier(0.4, 0, 1, 1),
			visibility 0s linear 180ms;
	}
	.more-menu:not([data-managed]):hover .more-panel,
	.more-menu:not([data-managed]):focus-within .more-panel,
	.more-menu[data-open='true'] .more-panel {
		visibility: visible;
		pointer-events: auto;
		opacity: 1;
		clip-path: inset(0 0 0 0 round var(--radius-medium));
		transition:
			clip-path 300ms cubic-bezier(0.22, 1, 0.36, 1),
			opacity 160ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s;
	}
	.more-panel a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-radius: 0.4rem;
		padding: 0.55rem 0.65rem;
		font-size: 16px;
		color: var(--color-text-secondary);
		text-decoration: none;
		opacity: 0;
		transform: translateY(-6px);
		transition:
			opacity 100ms cubic-bezier(0.4, 0, 1, 1),
			transform 140ms cubic-bezier(0.4, 0, 1, 1);
	}
	.more-menu:not([data-managed]):hover .more-panel a,
	.more-menu:not([data-managed]):focus-within .more-panel a,
	.more-menu[data-open='true'] .more-panel a {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
		transition-delay: calc(var(--index, 0) * 50ms + 40ms);
	}
	.more-menu:has(:focus-visible) .more-panel,
	.more-menu:has(:focus-visible) .more-panel a {
		transition: none;
	}
	.more-panel a:hover {
		background: var(--color-background-secondary-hover);
		text-decoration: none;
	}
	.more-panel a:focus-visible {
		text-decoration: none;
	}
	.mobile-toggle,
	.mobile-menu {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.more-menu .more-panel,
		.more-menu .more-panel a,
		.site-header,
		.nav-mask > div,
		.nav-mask > div::after,
		.brand,
		.mobile-menu a,
		.mobile-more-toggle {
			transition: none !important;
		}
	}

	@media (max-width: 600px) {
		.site-header {
			height: 48px;
			overflow: hidden;
		}
		.header-inner {
			height: 48px;
		}
		.desktop-nav {
			display: none;
		}
		.brand {
			pointer-events: none;
			transition-delay: 350ms;
		}
		.mobile-toggle {
			position: absolute;
			top: 0;
			left: 50%;
			display: grid;
			width: 3rem;
			height: 48px;
			place-items: center;
			border: 0;
			background: transparent;
			color: var(--color-text-secondary);
			cursor: pointer;
			transform: translateX(-50%);
		}
		.mobile-chevron {
			position: relative;
			display: block;
			width: 24px;
			height: 48px;
		}
		.mobile-chevron > span {
			position: absolute;
			top: 28px;
			width: 12px;
			height: 1px;
			background: currentColor;
			transition:
				transform 600ms var(--ease-standard),
				transform-origin 600ms var(--ease-standard),
				top 600ms var(--ease-standard);
		}
		.chevron-left {
			left: 0;
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 100% 100%;
		}
		.chevron-right {
			right: 0;
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 0 100%;
		}
		.mobile-toggle[aria-expanded='true'] .mobile-chevron > span {
			top: 16px;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-left {
			transform: rotate(-40deg) scaleY(1.5);
			transform-origin: 100% 0;
		}
		.mobile-toggle[aria-expanded='true'] .chevron-right {
			transform: rotate(40deg) scaleY(1.5);
			transform-origin: 0 0;
		}
		.mobile-menu {
			display: block;
			width: 100%;
		}
		.mobile-menu-inner {
			display: flex;
			width: 100%;
			flex-wrap: wrap;
		}
		.mobile-menu a,
		.mobile-more-toggle {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			height: 48px;
			padding: 0 4px;
			color: var(--color-text-secondary);
			font-size: 16px;
			text-decoration: none;
			opacity: 0;
			transform: translateY(-10%);
			pointer-events: none;
			transition:
				transform 400ms ease,
				opacity 400ms ease,
				color 500ms ease;
		}
		.mobile-menu-inner > a:not(.mobile-search-button),
		.mobile-more {
			width: 100%;
		}
		.mobile-more {
			display: flex;
			align-items: center;
		}
		.mobile-more-toggle {
			flex: none;
			border: 0;
			background: transparent;
			text-align: left;
			cursor: pointer;
		}
		.mobile-more-panel {
			display: flex;
			min-width: 0;
			flex: 1;
			align-items: center;
			overflow-x: auto;
			overflow-y: hidden;
			pointer-events: none;
			scrollbar-width: none;
		}
		.mobile-more-panel::-webkit-scrollbar {
			display: none;
		}
		.mobile-more-panel a {
			flex: none;
			transform: translateY(50%);
		}
		.mobile-menu[aria-hidden='false'] .mobile-menu-inner > a,
		.mobile-menu[aria-hidden='false'] .mobile-more-toggle {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
			transition-delay: calc(var(--index, 0) * 50ms + 100ms);
		}
		.mobile-menu[aria-hidden='false']
			.mobile-more[data-open='true']
			.mobile-more-panel {
			pointer-events: auto;
		}
		.mobile-menu[aria-hidden='false']
			.mobile-more[data-open='true']
			.mobile-more-panel
			a {
			transform: translateY(0);
			opacity: 1;
			pointer-events: auto;
			transition-delay: calc(var(--index, 0) * 50ms + 100ms);
		}
		.mobile-menu a:hover {
			color: var(--color-text-secondary-hover);
			text-decoration: none;
		}
		.mobile-menu a:focus-visible {
			text-decoration: none;
		}
		:global(.menu-open) {
			overflow: hidden;
		}
		:global(.menu-open) .nav-mask > div {
			--mask-base-height: calc(var(--open-height, 100dvh) * 4);
		}
		:global(.menu-open) .nav-mask > div::after {
			opacity: 1;
		}
		:global(.menu-open) .site-header {
			height: var(--open-height, 100dvh);
		}
		:global(.menu-open) .brand {
			transform: translateY(8px);
			opacity: 0;
			transition-delay: 0s;
		}
	}
</style>
