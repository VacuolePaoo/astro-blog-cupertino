---
import type { PageEntry } from '../types/page'
import ArticleComments from '../components/comments/ArticleComments.astro'
import PageHeading from '../components/PageHeading.astro'
import { getPageUrl } from '../utils/page'
import Layout from './Layout.astro'

interface Props {
	page: PageEntry
}

const { page } = Astro.props
---

<Layout title={page.data.title} description={page.data.description}>
	<div class="content-page">
		<PageHeading title={page.data.title} />
		<div class="article-shell">
			<div class="prose">
				<slot />
			</div>
			{
				page.data.comment === true && (
					<ArticleComments path={getPageUrl(page)} />
				)
			}
		</div>
	</div>
</Layout>

<style>
	.prose {
		margin-top: 32px;
	}
</style>
