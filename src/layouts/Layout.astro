---
import type { UiMessageKey } from '../types/i18n'
import blogConfig from '../../blog.config'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import RainbowBanner from '../components/RainbowBanner.astro'
import SeoHead from '../components/seo/SeoHead.astro'
import { translate } from '../utils/i18n'
import { assertAllowedImageSource } from '../utils/image'
import '@fontsource-variable/inter'
import '../styles/global.scss'

interface Props {
	title?: string | undefined
	description?: string | undefined
	image?: string | undefined
	canonical?: string | undefined
	noindex?: boolean | undefined
	type?: 'website' | 'article' | undefined
	pubDate?: string | undefined
	updatedDate?: string | undefined
	titleKey?: UiMessageKey | undefined
	descriptionKey?: UiMessageKey | undefined
	titleValues?: Record<string, string | number> | undefined
	descriptionValues?: Record<string, string | number> | undefined
}

const props = Astro.props
const pageType =
	props.type === 'article'
		? 'article'
		: Astro.url.pathname === '/search/'
			? 'search'
			: Astro.url.pathname === '/'
				? 'home'
				: 'website'
const defaultTheme = blogConfig.theme.appearance.colorScheme
const siteLogo =
	'logo' in blogConfig && typeof blogConfig.logo === 'string'
		? blogConfig.logo
		: undefined
for (const [label, source] of [
	['favicon', blogConfig.favicon],
	['logo', siteLogo],
	['author.avatar', blogConfig.author.avatar],
] as const)
	if (source) assertAllowedImageSource(source, blogConfig.imageDomains, label)
const reactRefreshPreamble = `
import RefreshRuntime from '/@react-refresh'
RefreshRuntime.injectIntoGlobalHook(window)
window.$RefreshReg$ = () => {}
window.$RefreshSig$ = () => type => type
window.__vite_plugin_react_preamble_installed__ = true
`
---

<!doctype html>
<html
	lang={blogConfig.language}
	data-time-zone={blogConfig.timeZone}
	data-default-theme={defaultTheme}
	data-site-title={blogConfig.title}
	style={`--site-accent:${blogConfig.accentColor}`}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={blogConfig.favicon} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content={blogConfig.accentColor} />
		{
			import.meta.env.DEV && (
				<script type="module" is:inline set:html={reactRefreshPreamble} />
			)
		}
		<script is:inline define:vars={{ defaultTheme }}>
			;(() => {
				const stored = localStorage.getItem('blog-theme')
				const theme = ['light', 'dark', 'auto'].includes(stored)
					? stored
					: defaultTheme
				const systemDark =
					theme === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches
				const dark = theme === 'dark' || systemDark
				document.documentElement.classList.toggle('dark', dark)
				document.documentElement.dataset.theme = theme
			})()
		</script>
		<SeoHead {...props} />
		{
			blogConfig.theme.motion.viewTransition && (
				<style is:inline set:html={'@view-transition { navigation: auto; }'} />
			)
		}
		{
			blogConfig.headScripts.map(script =>
				'src' in script ? (
					<script
						is:inline
						src={script.src}
						async={script.async}
						defer={script.defer}
						type={script.type}
						integrity={script.integrity}
						crossorigin={script.crossorigin}
					/>
				) : (
					<script is:inline type={script.type} set:html={script.content} />
				),
			)
		}
	</head>
	<body
		data-page-type={pageType}
		data-i18n-title={props.titleKey}
		data-i18n-description={props.descriptionKey}
		data-i18n-title-values={props.titleValues
			? JSON.stringify(props.titleValues)
			: undefined}
		data-i18n-description-values={props.descriptionValues
			? JSON.stringify(props.descriptionValues)
			: undefined}
		style={`--config-corner-squircle:${blogConfig.theme.appearance.squircle}`}
	>
		<a class="skip-link" href="#main-content" data-i18n="skip.content"
			>{translate('skip.content')}</a
		>
		<Header />
		<RainbowBanner />
		<main id="main-content">
			<slot />
		</main>
		{pageType !== 'search' && <Footer />}
		<script>
			import blogConfig from '../../blog.config'
			import { resolveUiLocale, translateWithValues } from '../utils/i18n'
			import { getClientLocale, initializeI18n } from '../utils/i18n-client'
			import { initializeScrollReveal } from '../utils/scroll-reveal'
			import { initializeSmoothScroll } from '../utils/smooth-scroll'

			function enhancePage() {
				initializeI18n()
				initializeScrollReveal()
				void initializeSmoothScroll(
					blogConfig.theme.motion.smoothScroll.enabled &&
						document.body.dataset.pageType !== 'search',
				)
				const times =
					document.querySelectorAll<HTMLTimeElement>('time[data-date]')
				const locale = getClientLocale()
				if (times.length && locale !== resolveUiLocale(blogConfig.language)) {
					void import('../utils/date-display').then(({ formatDisplayDate }) => {
						times.forEach(time => {
							const text = formatDisplayDate(
								time.dataset.date!,
								blogConfig.theme.content.dates.displayFormat,
								locale,
							)
							const primary = time.querySelector<HTMLElement>('.date-primary')
							if (primary) primary.textContent = text
							const updated = time.dataset.updatedDate
							if (updated) {
								const updatedText = translateWithValues(
									'article.updated',
									{
										date: formatDisplayDate(
											updated,
											blogConfig.theme.content.dates.displayFormat,
											locale,
										),
									},
									locale,
								)
								const tooltip = time.querySelector<HTMLElement>('.date-updated')
								if (tooltip) tooltip.textContent = updatedText
								time.setAttribute(
									'aria-label',
									`${text}${locale === 'zh-CN' ? '，' : ', '}${updatedText}`,
								)
							} else time.setAttribute('aria-label', text)
						})
					})
				}
			}
			enhancePage()
			document.addEventListener('astro:page-load', enhancePage)
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: fixed;
		top: 0;
		left: 50%;
		z-index: 1100;
		border: 1px solid var(--color-border-primary);
		transform: translateX(-50%) translateY(-100%) scale(0.9);
		border-radius: var(--radius-full);
		background: var(--color-background-secondary-translucent);
		backdrop-filter: var(--filter-blur);
		padding: 10px 20px;
		color: var(--color-text-primary);
		opacity: 0;
		transition:
			transform 200ms ease-out,
			box-shadow 200ms ease-out,
			opacity 200ms ease-out;
	}
	.skip-link:focus {
		transform: translateX(-50%) translateY(calc(-50% + 48px));
		box-shadow: 0 8px 24px rgb(0 0 0 / 0.13);
		opacity: 1;
	}
</style>
