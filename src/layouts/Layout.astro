---
import { ClientRouter } from 'astro:transitions'
import blogConfig from '../../blog.config'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SeoHead from '../components/seo/SeoHead.astro'
import { assertAllowedImageSource } from '../utils/image'
import '../styles/global.css'

interface Props {
	title?: string | undefined
	description?: string | undefined
	image?: string | undefined
	canonical?: string | undefined
	noindex?: boolean | undefined
	type?: 'website' | 'article' | undefined
	pubDate?: string | undefined
	updatedDate?: string | undefined
}

const props = Astro.props
const siteLogo =
	'logo' in blogConfig && typeof blogConfig.logo === 'string'
		? blogConfig.logo
		: undefined
for (const [label, source] of [
	['favicon', blogConfig.favicon],
	['logo', siteLogo],
	['author.avatar', blogConfig.author.avatar],
] as const)
	if (source) assertAllowedImageSource(source, blogConfig.imageDomains, label)
const reactRefreshPreamble = `
import RefreshRuntime from '/@react-refresh'
RefreshRuntime.injectIntoGlobalHook(window)
window.$RefreshReg$ = () => {}
window.$RefreshSig$ = () => type => type
window.__vite_plugin_react_preamble_installed__ = true
`
---

<!doctype html>
<html
	lang={blogConfig.language}
	data-time-zone={blogConfig.timeZone}
	style={`--site-accent:${blogConfig.accentColor}`}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" href={blogConfig.favicon} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content={blogConfig.accentColor} />
		{
			import.meta.env.DEV && (
				<script type="module" is:inline set:html={reactRefreshPreamble} />
			)
		}
		<script is:inline>
			;(() => {
				const theme = localStorage.getItem('blog-theme') || 'auto'
				const systemDark =
					theme === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches
				const dark = theme === 'dark' || systemDark
				document.documentElement.classList.toggle('dark', dark)
				document.documentElement.dataset.theme = theme
			})()
		</script>
		<SeoHead {...props} />
		<ClientRouter />
		{
			blogConfig.headScripts.map(script =>
				'src' in script ? (
					<script
						is:inline
						src={script.src}
						async={script.async}
						defer={script.defer}
						type={script.type}
						integrity={script.integrity}
						crossorigin={script.crossorigin}
					/>
				) : (
					<script is:inline type={script.type} set:html={script.content} />
				),
			)
		}
	</head>
	<body>
		<a class="skip-link" href="#main-content"> 跳到正文 </a>
		<Header />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
		<script>
			function formatListDate(value: string) {
				const timeZone = document.documentElement.dataset.timeZone || 'UTC'
				const parts = new Intl.DateTimeFormat('en-CA', {
					timeZone,
					year: 'numeric',
					month: '2-digit',
					day: '2-digit',
				}).formatToParts(new Date())
				const record = Object.fromEntries(
					parts.map(part => [part.type, part.value]),
				)
				const today = Date.UTC(
					Number(record.year),
					Number(record.month) - 1,
					Number(record.day),
				)
				const [year, month, day] = value.split('-').map(Number)
				const target = Date.UTC(year!, month! - 1, day!)
				const days = Math.floor((today - target) / 86_400_000)
				if (days <= 0) return '今天'
				if (days <= 7) return `${days}天前`
				if (year === Number(record.year)) return `${month}月${day}日`
				return `${String(year).slice(-2)}年${month}月${day}日`
			}

			function enhancePage() {
				document
					.querySelectorAll<HTMLElement>('.prose pre.astro-code')
					.forEach(pre => {
						if (pre.querySelector('.code-copy')) return
						const button = document.createElement('button')
						button.type = 'button'
						button.className = 'code-copy'
						button.textContent = '复制'
						button.addEventListener('click', async () => {
							await navigator.clipboard.writeText(
								pre.querySelector('code')?.textContent ?? '',
							)
							button.textContent = '已复制'
							setTimeout(() => (button.textContent = '复制'), 1200)
						})
						pre.append(button)
					})
				document
					.querySelectorAll<HTMLTimeElement>(
						'time[data-mode="list"][data-date]',
					)
					.forEach(time => {
						const primary = time.querySelector<HTMLElement>('.date-primary')
						if (primary)
							primary.textContent = formatListDate(time.dataset.date!)
					})
			}
			enhancePage()
			document.addEventListener('astro:page-load', enhancePage)
		</script>
	</body>
</html>

<style>
	main {
		min-height: 58vh;
	}
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 100;
		transform: translateY(-150%);
		border-radius: 0.4rem;
		background: var(--color-accent);
		padding: 0.55rem 0.8rem;
		color: white;
	}
	.skip-link:focus {
		transform: translateY(0);
	}
</style>
