---
import type { MarkdownHeading } from 'astro'
import type { ArticleEntry } from '../types/article'
import ArticleCover from '../components/ArticleCover.astro'
import ArticleFooter from '../components/ArticleFooter.astro'
import ArticleToc from '../components/ArticleToc.astro'
import DateDisplay from '../components/DateDisplay.astro'
import { getTaxonomyUrl } from '../utils/taxonomy'
import Layout from './Layout.astro'

interface Props {
	article: ArticleEntry
	headings: MarkdownHeading[]
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, headings, newer, older, preview = false } = Astro.props
const ogImage = `/og/${preview ? 'previews' : 'posts'}/${article.id}.png`
---

<Layout
	title={article.data.title}
	description={article.data.description}
	image={ogImage}
	noindex={preview}
	type="article"
	pubDate={article.data.pubDate}
	updatedDate={article.data.updatedDate}
>
	<article class="article-page">
		{
			article.data.cover && (
				<div class="article-cover" aria-hidden="true" data-article-cover>
					<ArticleCover src={article.data.cover} alt="" eager />
				</div>
			)
		}
		<header class="article-header">
			<div class="article-header-copy article-shell">
				<div class="article-meta">
					<a href={getTaxonomyUrl('categories', article.data.collection)}>
						{article.data.collection}
					</a>
					<DateDisplay
						date={article.data.pubDate}
						updatedDate={article.data.updatedDate}
						mode="full"
					/>
					{preview && <span class="draft-badge">非正式版</span>}
				</div>
				<h1 class="article-title">{article.data.title}</h1>
			</div>
		</header>
		<div class="article-content-shell article-shell">
			<ArticleToc headings={headings} />
			<div class="prose">
				<slot />
			</div>
			<ArticleFooter
				article={article}
				newer={newer}
				older={older}
				preview={preview}
			/>
		</div>
	</article>
</Layout>

<style>
	.article-page {
		position: relative;
	}
	.article-header {
		position: relative;
		z-index: 1;
		margin-top: 128px;
	}
	.article-header-copy {
		position: relative;
		z-index: 1;
		padding-inline: 16px;
	}
	.article-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 600;
		line-height: normal;
	}
	.article-meta > a {
		color: var(--color-text-accent);
		font-size: 13px;
		text-transform: uppercase;
	}
	.article-meta a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.article-title {
		margin: 16px 0 0;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	.article-cover {
		position: relative;
		width: 100%;
		height: 300px;
		overflow: hidden;
		margin-bottom: -180px;
		--cover-height: 300px;
		mask-image: linear-gradient(
			to bottom,
			#000 0%,
			rgb(0 0 0 / 0.987) 8.1%,
			rgb(0 0 0 / 0.951) 15.5%,
			rgb(0 0 0 / 0.896) 22.5%,
			rgb(0 0 0 / 0.825) 29%,
			rgb(0 0 0 / 0.741) 35.3%,
			rgb(0 0 0 / 0.648) 41.2%,
			rgb(0 0 0 / 0.55) 47.1%,
			rgb(0 0 0 / 0.45) 52.9%,
			rgb(0 0 0 / 0.352) 58.8%,
			rgb(0 0 0 / 0.259) 64.7%,
			rgb(0 0 0 / 0.175) 71%,
			rgb(0 0 0 / 0.104) 77.5%,
			rgb(0 0 0 / 0.049) 84.5%,
			rgb(0 0 0 / 0.013) 91.9%,
			transparent 100%
		);
		pointer-events: none;
	}
	.article-cover :global(picture),
	.article-cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.article-cover :global(img) {
		object-fit: cover;
	}
	.article-content-shell {
		margin-top: 0;
	}
	.prose {
		margin-top: 64px;
	}
	.draft-badge {
		border: 1px solid var(--color-text-warning);
		border-radius: 999px;
		padding: 0.12rem 0.42rem;
		background: var(--color-background-warning);
		color: var(--color-text-warning);
	}
	@supports (animation-timeline: scroll()) {
		.article-cover {
			--cover-scroll-range: calc(var(--cover-height) * 3);
			--cover-offset: 0.5;
			animation: article-cover-exit linear both;
			animation-timeline: scroll();
			animation-range: 0 var(--cover-scroll-range);
		}
		@keyframes article-cover-exit {
			to {
				opacity: 0;
				scale: 1.2;
				margin-top: calc(var(--cover-scroll-range) * var(--cover-offset));
				margin-bottom: calc(
					-1 * var(--cover-scroll-range) * var(--cover-offset)
				);
				filter: var(--filter-blur);
			}
		}
	}
</style>
