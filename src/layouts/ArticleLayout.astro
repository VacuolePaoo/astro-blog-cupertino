---
import type { MarkdownHeading } from 'astro'
import type { ArticleEntry } from '../types/article'
import ArticleCover from '../components/ArticleCover.astro'
import ArticleFooter from '../components/ArticleFooter.astro'
import ArticleToc from '../components/ArticleToc.astro'
import DateDisplay from '../components/DateDisplay.astro'
import Layout from './Layout.astro'

interface Props {
	article: ArticleEntry
	headings: MarkdownHeading[]
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, headings, newer, older, preview = false } = Astro.props
const ogImage = `/og/${preview ? 'previews' : 'posts'}/${article.id}.png`
---

<Layout
	title={article.data.title}
	description={article.data.description}
	image={ogImage}
	noindex={preview}
	type="article"
	pubDate={article.data.pubDate}
	updatedDate={article.data.updatedDate}
>
	<article class="article-page">
		<header
			class:list={[
				'article-header',
				{ 'article-header--with-cover': article.data.cover },
			]}
		>
			{
				article.data.cover && (
					<div class="article-cover" aria-hidden="true">
						<ArticleCover src={article.data.cover} alt="" eager />
					</div>
				)
			}
			<div class="article-header-copy article-shell">
				<div class="article-meta">
					<a
						href={`/posts/?collection=${encodeURIComponent(article.data.collection)}`}
					>
						{article.data.collection}
					</a>
					<DateDisplay
						date={article.data.pubDate}
						updatedDate={article.data.updatedDate}
						mode="full"
					/>
					{preview && <span class="draft-badge">非正式版</span>}
				</div>
				<h1 class="article-title">{article.data.title}</h1>
			</div>
		</header>
		<div class="page-shell article-grid">
			<div>
				<div class="mobile-toc">
					<ArticleToc headings={headings} mode="mobile" />
				</div>
				<div class="prose">
					<slot />
				</div>
				<ArticleFooter
					article={article}
					newer={newer}
					older={older}
					preview={preview}
				/>
			</div>
			<div class="desktop-toc">
				<ArticleToc headings={headings} mode="desktop" />
			</div>
		</div>
	</article>
</Layout>

<style>
	.article-page {
		position: relative;
	}
	.article-header {
		position: relative;
		min-height: 300px;
	}
	.article-header-copy {
		position: relative;
		z-index: 1;
		padding-top: 128px;
		padding-bottom: 24px;
	}
	.article-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		color: var(--color-muted);
		font-size: 16px;
		font-weight: 600;
		line-height: normal;
	}
	.article-meta > a {
		color: var(--color-accent);
		font-size: 13px;
		text-transform: uppercase;
	}
	.article-meta a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.article-title {
		max-width: 20ch;
		margin: 16px 0 0;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	.article-cover {
		position: absolute;
		inset: 0 0 auto;
		height: 300px;
		overflow: hidden;
		opacity: 0.82;
		mask-image: linear-gradient(to bottom, #000 32%, transparent 100%);
	}
	.article-cover :global(picture),
	.article-cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.article-cover :global(img) {
		object-fit: cover;
		filter: saturate(0.88);
	}
	.article-grid {
		display: grid;
		grid-template-columns: minmax(0, 800px) minmax(130px, 160px);
		gap: 40px;
		align-items: start;
		margin-top: 64px;
	}
	.mobile-toc {
		display: none;
	}
	.draft-badge {
		border: 1px solid color-mix(in oklab, #ff9f0a 55%, var(--color-border));
		border-radius: 999px;
		padding: 0.12rem 0.42rem;
		color: #c66c00;
	}
	@media (max-width: 980px) {
		.article-grid {
			display: block;
		}
		.mobile-toc {
			display: block;
		}
		.desktop-toc {
			display: none;
		}
	}
	@media (max-width: 700px) {
		.article-header {
			min-height: 260px;
		}
		.article-header-copy {
			padding-top: 96px;
		}
		.article-cover {
			height: 260px;
		}
		.article-grid {
			margin-top: 40px;
		}
	}
</style>
