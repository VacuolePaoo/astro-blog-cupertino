---
import type { MarkdownHeading } from 'astro'
import type { ArticleEntry } from '../types/article'
import blogConfig from '../../blog.config'
import ArticleCover from '../components/ArticleCover.astro'
import ArticleFooter from '../components/ArticleFooter.astro'
import ArticleToc from '../components/ArticleToc.astro'
import DateDisplay from '../components/DateDisplay.astro'
import { translate } from '../utils/i18n'
import { getTaxonomyUrl } from '../utils/taxonomy'
import Layout from './Layout.astro'

interface Props {
	article: ArticleEntry
	headings: MarkdownHeading[]
	newer?: ArticleEntry | undefined
	older?: ArticleEntry | undefined
	preview?: boolean
}

const { article, headings, newer, older, preview = false } = Astro.props
const ogImage = `/og/${preview ? 'previews' : 'posts'}/${article.id}.png`
---

<Layout
	title={article.data.title}
	description={article.data.description}
	image={ogImage}
	noindex={preview}
	type="article"
	pubDate={article.data.pubDate}
	updatedDate={article.data.updatedDate}
>
	<article class="article-page">
		{
			article.data.cover && (
				<div class="article-cover" aria-hidden="true" data-article-cover>
					<div
						class:list={[
							'article-cover-media',
							{
								'animate-cover':
									blogConfig.theme.motion.heroExitWhileScrolling.enabled,
								'with-blur':
									blogConfig.theme.motion.heroExitWhileScrolling.blurFilter,
							},
						]}
					>
						<ArticleCover src={article.data.cover} alt="" eager />
					</div>
				</div>
			)
		}
		<header class="article-header">
			<div class="article-header-copy article-shell">
				<div class="article-meta">
					<a
						class:list={{
							uppercase: blogConfig.theme.content.categories.uppercase,
						}}
						href={getTaxonomyUrl('categories', article.data.collection)}
					>
						{article.data.collection}
					</a>
					<DateDisplay
						date={article.data.pubDate}
						updatedDate={article.data.updatedDate}
						mode="full"
					/>
					{
						preview && (
							<span class="draft-badge" data-i18n="article.draft">
								{translate('article.draft')}
							</span>
						)
					}
				</div>
				<h1 class="article-title">{article.data.title}</h1>
			</div>
		</header>
		<div class="article-content-shell article-shell">
			<ArticleToc headings={headings} />
			<div class="prose">
				<slot />
			</div>
			<ArticleFooter
				article={article}
				newer={newer}
				older={older}
				preview={preview}
			/>
		</div>
	</article>
</Layout>

<style>
	.article-page {
		position: relative;
		container-type: inline-size;
	}
	.article-header {
		position: relative;
		z-index: 1;
		margin-top: 128px;
	}
	.article-header-copy {
		position: relative;
		z-index: 1;
		padding-inline: 16px;
	}
	.article-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 600;
		line-height: normal;
	}
	.article-meta > a {
		color: var(--color-text-accent);
		font-size: 13px;
		line-height: 20px;
	}
	.article-meta > a.uppercase {
		text-transform: uppercase;
	}
	.article-meta a:hover {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.article-title {
		margin: 16px 0 0;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	.article-cover {
		position: relative;
		width: 100%;
		height: 124px;
		overflow: clip visible;
		pointer-events: none;
	}
	.article-cover-media {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 300px;
		--cover-height: 300px;
		mask-image: linear-gradient(
			to bottom,
			#000 0%,
			rgb(0 0 0 / 0.987) 8.1%,
			rgb(0 0 0 / 0.951) 15.5%,
			rgb(0 0 0 / 0.896) 22.5%,
			rgb(0 0 0 / 0.825) 29%,
			rgb(0 0 0 / 0.741) 35.3%,
			rgb(0 0 0 / 0.648) 41.2%,
			rgb(0 0 0 / 0.55) 47.1%,
			rgb(0 0 0 / 0.45) 52.9%,
			rgb(0 0 0 / 0.352) 58.8%,
			rgb(0 0 0 / 0.259) 64.7%,
			rgb(0 0 0 / 0.175) 71%,
			rgb(0 0 0 / 0.104) 77.5%,
			rgb(0 0 0 / 0.049) 84.5%,
			rgb(0 0 0 / 0.013) 91.9%,
			transparent 100%
		);
	}
	.article-cover-media :global(picture),
	.article-cover-media :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.article-cover-media :global(img) {
		object-fit: cover;
	}
	.article-content-shell {
		margin-top: 0;
	}
	.prose {
		margin-top: 64px;
	}
	.draft-badge {
		border: 1px solid var(--color-text-warning);
		border-radius: 999px;
		padding: 0.12rem 0.42rem;
		background: var(--color-background-warning);
		color: var(--color-text-warning);
	}
	@supports (animation-timeline: scroll()) {
		.article-cover-media.animate-cover {
			--cover-scroll-range: calc(var(--cover-height) * 3);
			will-change: filter, opacity, transform;
			animation-name: article-cover-exit;
			animation-duration: 1s;
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root block);
			animation-range: 0 var(--cover-scroll-range);
		}
		.article-cover-media.with-blur {
			animation-name: article-cover-exit-with-blur;
		}
		@keyframes article-cover-exit {
			to {
				opacity: 0;
				transform: translateY(450px) scale(1.2);
			}
		}
		@keyframes article-cover-exit-with-blur {
			to {
				opacity: 0;
				transform: translateY(450px) scale(1.2);
				filter: var(--filter-blur);
			}
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.article-cover-media {
			animation: none !important;
			opacity: 1;
			filter: none;
			transform: none;
		}
	}
</style>
