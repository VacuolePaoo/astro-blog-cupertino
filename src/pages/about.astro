---
import Layout from '../layouts/Layout.astro'
import { translate } from '../utils/i18n'
---

<Layout
	title={translate('page.about')}
	titleKey="page.about"
	description={translate('page.aboutDescription')}
	descriptionKey="page.aboutDescription"
>
	<section class="page-shell empty-page">
		<h1 data-i18n="page.about">{translate('page.about')}</h1>
	</section>
</Layout>

<style>
	.empty-page {
		min-height: 58vh;
		padding-top: 128px;
	}
	h1 {
		margin: 0;
		font-size: 48px;
		font-weight: 700;
		line-height: normal;
	}
</style>
