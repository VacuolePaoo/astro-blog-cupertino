---
import { Atom, Check, Copy, Rss, X } from 'lucide-astro'
import PageHeading from '../components/PageHeading.astro'
import Layout from '../layouts/Layout.astro'
import { siteOrigin } from '../utils/site'

const feeds = [
	{
		title: 'Atom',
		description: '结构清晰、支持稳定标识的 Atom 1.0 摘要订阅。',
		url: new URL('/atom.xml', siteOrigin).href,
		Icon: Atom,
	},
	{
		title: 'RSS',
		description: '兼容广泛阅读器的 RSS 2.0 摘要订阅。',
		url: new URL('/rss.xml', siteOrigin).href,
		Icon: Rss,
	},
] as const
---

<Layout title="订阅" description="通过 Atom 或 RSS 获取最近更新。">
	<section class="page-shell subscribe-page page-bottom">
		<PageHeading title="订阅" />
		<div class="feed-grid card-grid card-grid--3">
			{
				feeds.map(({ title, description, url, Icon }) => (
					<article class="feed-card surface-card">
						<Icon size={24} strokeWidth={1.7} />
						<h2>{title}</h2>
						<p>{description}</p>
						<button type="button" data-copy-feed={url} data-copy-state="idle" disabled>
							<span class="copy-icons" aria-hidden="true">
								<Copy class="idle-icon" size={16} />
								<Check class="copied-icon" size={16} />
								<X class="failed-icon" size={16} />
							</span>
							<span class="copy-labels">
								<span>复制地址</span>
								<span>已复制</span>
								<span>复制失败</span>
							</span>
						</button>
						<span class="sr-only" role="status" data-copy-status />
					</article>
				))
			}
		</div>
	</section>
</Layout>

<script>
	import { copyText } from '../utils/clipboard'

	type CopyState = 'idle' | 'copied' | 'failed'

	const COPY_STATUS_TEXT: Record<CopyState, string> = {
		idle: '',
		copied: '已复制',
		failed: '复制失败',
	}
	const COPY_RESET_DELAY = 1400
	const copyResetTimers = new WeakMap<
		HTMLButtonElement,
		ReturnType<typeof setTimeout>
	>()

	function enableCopyButtons() {
		document
			.querySelectorAll<HTMLButtonElement>('[data-copy-feed]')
			.forEach(button => (button.disabled = false))
	}

	function setCopyState(button: HTMLButtonElement, state: CopyState) {
		button.dataset.copyState = state
		const status = button.parentElement?.querySelector<HTMLElement>(
			'[data-copy-status]',
		)
		if (status) status.textContent = COPY_STATUS_TEXT[state]
	}

	function scheduleCopyReset(button: HTMLButtonElement) {
		const previousTimer = copyResetTimers.get(button)
		if (previousTimer) clearTimeout(previousTimer)
		copyResetTimers.set(
			button,
			setTimeout(() => setCopyState(button, 'idle'), COPY_RESET_DELAY),
		)
	}

	document.addEventListener('click', async event => {
		const button = (event.target as Element).closest<HTMLButtonElement>(
			'[data-copy-feed]',
		)
		if (!button) return
		const succeeded = await copyText(button.dataset.copyFeed ?? '')
		setCopyState(button, succeeded ? 'copied' : 'failed')
		scheduleCopyReset(button)
	})
	enableCopyButtons()
	document.addEventListener('astro:page-load', enableCopyButtons)
</script>

<style>
	.feed-grid {
		margin-top: 64px;
	}
	.feed-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		overflow: hidden;
		padding: 18px;
	}
	.feed-card h2 {
		margin: 0;
		font-size: var(--text-card-title);
		font-weight: 700;
		line-height: normal;
	}
	.feed-card p {
		margin: 0;
		color: var(--color-text-secondary);
		font-size: var(--text-card-description);
		font-weight: 400;
	}
	.feed-card button {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		border: 0;
		border-radius: var(--radius-full);
		background: var(--color-background-accent);
		padding: 6px 12px;
		color: var(--color-background-accent-contrast);
		font-size: var(--font-size-base);
		font-weight: 400;
		line-height: 1;
		cursor: pointer;
	}
	.copy-icons {
		display: grid;
		width: 16px;
		height: 16px;
	}
	.copy-labels {
		display: grid;
	}
	.copy-icons :global(svg),
	.copy-labels span {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transform: scale(0.85);
		/* Inactive items fade out first; visibility flips only after the fade
		   so screen readers never see more than one label per state. */
		transition:
			opacity 180ms cubic-bezier(0.2, 0.2, 0.2, 1),
			transform 180ms cubic-bezier(0.2, 0.2, 0.2, 1),
			visibility 0s linear 180ms;
	}
	[data-copy-state='idle'] .copy-icons :global(.idle-icon),
	[data-copy-state='copied'] .copy-icons :global(.copied-icon),
	[data-copy-state='failed'] .copy-icons :global(.failed-icon),
	[data-copy-state='idle'] .copy-labels span:nth-child(1),
	[data-copy-state='copied'] .copy-labels span:nth-child(2),
	[data-copy-state='failed'] .copy-labels span:nth-child(3) {
		opacity: 1;
		visibility: visible;
		transform: scale(1);
		/* No visibility transition in the active list, so the incoming item
		   becomes visible immediately while it fades in. */
		transition:
			opacity 180ms cubic-bezier(0.2, 0.2, 0.2, 1),
			transform 180ms cubic-bezier(0.2, 0.2, 0.2, 1);
	}
	.feed-card button:hover {
		background: var(--color-background-accent-hover);
		text-decoration: none;
	}
	.feed-card button:disabled {
		cursor: default;
		opacity: 0.6;
	}
</style>
