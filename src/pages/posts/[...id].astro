---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import ArticleLayout from '../../layouts/ArticleLayout.astro'
import StoryArticleLayout from '../../layouts/StoryArticleLayout.astro'
import {
	getArticles,
	getArticleSlug,
	getArticleSurround,
} from '../../utils/article'

export const getStaticPaths = (async () => {
	const articles = await getArticles()
	return articles.map(article => ({
		params: { id: getArticleSlug(article) },
		props: { article, articles },
	}))
}) satisfies GetStaticPaths

const { article, articles } = Astro.props
const { Content, headings } = await render(article)
const { newer, older } = getArticleSurround(articles, article)
---

{
	article.data.type === 'story' ? (
		<StoryArticleLayout
			article={article}
			headings={headings}
			newer={newer}
			older={older}
		>
			<Content />
		</StoryArticleLayout>
	) : (
		<ArticleLayout
			article={article}
			headings={headings}
			newer={newer}
			older={older}
		>
			<Content />
		</ArticleLayout>
	)
}
