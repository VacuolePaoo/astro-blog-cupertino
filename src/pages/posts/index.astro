---
import ArchiveList from '../../components/ArchiveList.astro'
import PageHeading from '../../components/PageHeading.astro'
import Layout from '../../layouts/Layout.astro'
import { getArticles } from '../../utils/article'
import { translate } from '../../utils/i18n'

const articles = await getArticles()
---

<Layout
	title={translate('page.posts')}
	titleKey="page.posts"
	description={translate('page.archivesDescription')}
	descriptionKey="page.archivesDescription"
>
	<div class="page-shell">
		<PageHeading title={translate('page.posts')} titleKey="page.posts" />
		<ArchiveList articles={articles} />
	</div>
</Layout>
