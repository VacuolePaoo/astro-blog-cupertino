---
import type { GetStaticPaths } from 'astro'
import HomeArticles from '../../components/HomeArticles.astro'
import { HOME_PAGE_SIZE } from '../../consts'
import Layout from '../../layouts/Layout.astro'
import { getArticles } from '../../utils/article'
import { translateWithValues } from '../../utils/i18n'

export const getStaticPaths = (async ({ paginate }) => {
	const articles = await getArticles()
	return paginate(articles, { pageSize: HOME_PAGE_SIZE }).filter(
		item => Number(item.params.page) > 1,
	)
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<Layout
	title={translateWithValues('page.homePageNumber', { page: page.currentPage })}
	titleKey="page.homePageNumber"
	titleValues={{ page: page.currentPage }}
	description={translateWithValues('page.latestPageDescription', {
		page: page.currentPage,
	})}
	descriptionKey="page.latestPageDescription"
	descriptionValues={{ page: page.currentPage }}
>
	<HomeArticles
		articles={page.data}
		currentPage={page.currentPage}
		totalPages={page.lastPage}
	/>
</Layout>
