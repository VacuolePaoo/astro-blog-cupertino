---
import PageHeading from '../../components/PageHeading.astro'
import TaxonomyIndex from '../../components/TaxonomyIndex.astro'
import Layout from '../../layouts/Layout.astro'
import { getArticles } from '../../utils/article'
import { translate } from '../../utils/i18n'
import { getTaxonomySummaries } from '../../utils/taxonomy'

const tags = getTaxonomySummaries(await getArticles(), 'tags')
---

<Layout
	title={translate('page.tags')}
	titleKey="page.tags"
	description={translate('page.tagsDescription')}
	descriptionKey="page.tagsDescription"
>
	<div class="page-shell">
		<PageHeading
			title={translate('page.tags')}
			titleKey="page.tags"
			containedOnMobile
		/>
		<TaxonomyIndex kind="tags" items={tags} />
	</div>
</Layout>
