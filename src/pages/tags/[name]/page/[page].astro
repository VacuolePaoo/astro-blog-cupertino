---
import type { GetStaticPaths } from 'astro'
import type { ArticleEntry } from '../../../../types/article'
import type { TaxonomySummary } from '../../../../types/taxonomy'
import TaxonomyArchive from '../../../../components/TaxonomyArchive.astro'
import { ARCHIVE_PAGE_SIZE } from '../../../../consts'
import { getArticles } from '../../../../utils/article'
import { paginate } from '../../../../utils/pagination'
import { getTaxonomySummaries } from '../../../../utils/taxonomy'

export const getStaticPaths = (async () => {
	const tags = getTaxonomySummaries(await getArticles(), 'tags')
	return tags.flatMap(tag =>
		Array.from(
			{ length: Math.max(0, Math.ceil(tag.count / ARCHIVE_PAGE_SIZE) - 1) },
			(_, index) => ({
				params: { name: tag.name, page: String(index + 2) },
				props: {
					tag,
					page: paginate(tag.articles, index + 2, ARCHIVE_PAGE_SIZE),
				},
			}),
		),
	)
}) satisfies GetStaticPaths

const { tag, page } = Astro.props as {
	tag: TaxonomySummary
	page: { items: ArticleEntry[]; currentPage: number; totalPages: number }
}
---

<TaxonomyArchive kind="tags" summary={tag} page={page} />
