---
import PageHeading from '../components/PageHeading.astro'
import WorkCard from '../components/works/WorkCard.astro'
import WorkDialog from '../components/works/WorkDialog.astro'
import Layout from '../layouts/Layout.astro'
import { getWorks } from '../utils/work'

const works = await getWorks()
---

<Layout title="作品" description="开发的项目与作品。">
	<section class="page-shell works-page page-bottom">
		<PageHeading title="作品" />
		{
			works.length > 0 ? (
				<div class="works-grid card-grid card-grid--2">
					{works.map(work => (
						<WorkCard work={work} />
					))}
				</div>
			) : (
				<p class="works-empty muted">作品正在整理中，敬请期待。</p>
			)
		}
	</section>
	<WorkDialog works={works} />
</Layout>

<style>
	:global(html.works-open) {
		overflow: hidden;
	}
	.works-grid {
		/* Every card shares one row height, so all cards end up identical. */
		grid-auto-rows: 1fr;
		margin-top: 64px;
	}
	.works-empty {
		margin-top: 64px;
	}
</style>

<script>
	import { initializeWorksDialog } from '../utils/works-dialog'

	initializeWorksDialog()
</script>
