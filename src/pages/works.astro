---
import Layout from '../layouts/Layout.astro'
import { translate } from '../utils/i18n'
---

<Layout
	title={translate('page.works')}
	titleKey="page.works"
	description={translate('page.worksMetaDescription')}
	descriptionKey="page.worksMetaDescription"
	noindex
>
	<section class="page-shell coming-soon">
		<p data-i18n="page.works">{translate('page.works')}</p>
		<h1 data-i18n="page.comingSoon">{translate('page.comingSoon')}</h1>
		<span data-i18n="page.worksDescription"
			>{translate('page.worksDescription')}</span
		>
	</section>
</Layout>

<style>
	.coming-soon {
		min-height: 58vh;
		padding-top: 128px;
	}
	p {
		color: var(--color-text-secondary);
		font-size: 22px;
		font-weight: 200;
	}
	h1 {
		margin: 6px 0 0;
		font-size: 48px;
		font-weight: 700;
		line-height: normal;
	}
	span {
		display: block;
		margin-top: 1rem;
		color: var(--color-text-secondary);
	}
</style>
