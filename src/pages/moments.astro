---
import PageHeading from '../components/PageHeading.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="动态" description="动态功能即将上线。" noindex>
	<section class="page-shell coming-soon page-bottom">
		<PageHeading title="动态" subtitle="即将上线" />
		<p class="note">这里会成为更轻量的短内容记录。</p>
	</section>
</Layout>

<style>
	.coming-soon {
		min-height: 58vh;
	}
	.note {
		margin-top: 1rem;
		color: var(--color-text-secondary);
	}
</style>
