---
import ArticleCard from '../components/ArticleCard.astro'
import Layout from '../layouts/Layout.astro'
import { getArticles } from '../utils/article'

const articles = (await getArticles()).slice(0, 3)
---

<Layout title="页面未找到" description="请求的页面不存在。" noindex>
	<section class="page-shell not-found">
		<p class="error-code">404</p>
		<h1>这里没有你寻找的页面</h1>
		<a class="home-button" href="/">返回首页</a>
		<div class="recommendations">
			<h2>最近文章</h2>
			{
				articles.map(article => (
					<ArticleCard article={article} variant="archive" />
				))
			}
		</div>
	</section>
</Layout>

<style>
	.not-found {
		padding-top: 128px;
	}
	.error-code {
		color: var(--color-text-accent);
		font-size: 16px;
		font-weight: 600;
	}
	h1 {
		max-width: 15ch;
		margin: 0;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	.home-button {
		display: inline-block;
		margin-top: 16px;
		border-radius: var(--radius-full);
		background: var(--color-background-accent);
		padding: 6px 12px;
		color: var(--color-background-accent-contrast);
		font-size: 16px;
		line-height: 1;
		font-weight: 400;
	}
	.home-button:hover {
		background: var(--color-background-accent-hover);
		text-decoration: none;
	}
	.recommendations {
		margin-top: 64px;
	}
	.recommendations h2 {
		font-size: 32px;
		font-weight: 700;
		line-height: 1.125;
	}
</style>
