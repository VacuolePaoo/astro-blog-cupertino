---
import ArticleCard from '../components/ArticleCard.astro'
import Layout from '../layouts/Layout.astro'
import { getArticles } from '../utils/article'
import { translate } from '../utils/i18n'

const articles = (await getArticles()).slice(0, 3)
---

<Layout
	title={translate('page.notFound')}
	titleKey="page.notFound"
	description={translate('page.notFoundMetaDescription')}
	descriptionKey="page.notFoundMetaDescription"
	noindex
>
	<section class="page-shell not-found">
		<p class="error-code">404</p>
		<h1 data-i18n="page.notFoundDescription">
			{translate('page.notFoundDescription')}
		</h1>
		<a class="home-button" href="/" data-i18n="page.backHome"
			>{translate('page.backHome')}</a
		>
		<div class="recommendations">
			<h2 data-i18n="home.latest">{translate('home.latest')}</h2>
			{
				articles.map(article => (
					<ArticleCard article={article} variant="archive" />
				))
			}
		</div>
	</section>
</Layout>

<style>
	.not-found {
		padding-top: 128px;
	}
	.error-code {
		color: var(--color-text-accent);
		font-size: 16px;
		font-weight: 600;
	}
	h1 {
		max-width: 15ch;
		margin: 0;
		font-size: 48px;
		font-weight: 700;
		line-height: normal;
	}
	.home-button {
		display: inline-block;
		margin-top: 16px;
		border-radius: var(--radius-full);
		background: var(--color-background-accent);
		padding: 6px 12px;
		color: var(--color-background-accent-contrast);
		font-size: 16px;
		line-height: 1;
		font-weight: 400;
	}
	.home-button:hover {
		background: var(--color-background-accent-hover);
		text-decoration: none;
	}
	.recommendations {
		margin-top: 64px;
	}
	.recommendations h2 {
		font-size: 32px;
		font-weight: 700;
		line-height: 1.125;
	}
</style>
