---
import { Rss } from 'lucide-astro'
import blogConfig from '../../blog.config'
import { friendGroups } from '../friends-links'
import Layout from '../layouts/Layout.astro'
import { assertAllowedImageSource } from '../utils/image'

for (const group of friendGroups)
	for (const friend of group.items)
		assertAllowedImageSource(
			friend.avatar,
			blogConfig.imageDomains,
			`友链 ${friend.title}`,
		)
---

<Layout title="友链" description="一些持续创作、互相启发的朋友与站点。">
	<section class="page-shell friends-page">
		<header>
			<h1>友链</h1>
			<p>一些持续创作、互相启发的朋友与站点。</p>
		</header>
		{
			friendGroups.map(group => (
				<section class="friend-group">
					<h2>{group.title}</h2>
					<div class="friend-grid">
						{group.items.map(friend => (
							<article class="friend-card surface-card interactive-card">
								<a
									class="friend-main"
									href={friend.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span
										class="friend-avatar"
										data-friend-avatar
										data-fallback={friend.title.slice(0, 1)}
									>
										<img
											src={friend.avatar}
											alt={`${friend.title} 的头像`}
											loading="lazy"
										/>
									</span>
									<span class="friend-copy">
										<strong>{friend.title}</strong>
										{friend.author && <small>{friend.author}</small>}
										{friend.description && <span>{friend.description}</span>}
									</span>
								</a>
								{friend.feed && (
									<a
										class="friend-feed"
										href={friend.feed}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`订阅 ${friend.title}`}
									>
										<Rss size={17} />
									</a>
								)}
							</article>
						))}
					</div>
				</section>
			))
		}
	</section>
</Layout>

<script>
	function initializeFriendAvatars() {
		document
			.querySelectorAll<HTMLElement>('[data-friend-avatar]')
			.forEach(avatar => {
				const image = avatar.querySelector('img')
				if (!image || image.dataset.fallbackReady) return
				image.dataset.fallbackReady = 'true'
				image.addEventListener('error', () => {
					image.remove()
					avatar.textContent = avatar.dataset.fallback ?? '•'
				})
			})
	}
	initializeFriendAvatars()
	document.addEventListener('astro:page-load', initializeFriendAvatars)
</script>

<style>
	.friends-page {
		padding-top: 128px;
		padding-bottom: 128px;
	}
	header h1 {
		margin: 0;
		font-size: var(--text-article-title);
		font-weight: 700;
		line-height: normal;
	}
	header p {
		color: var(--color-text-secondary);
		font-size: 16px;
		font-weight: 400;
	}
	.friend-group {
		margin-top: 64px;
	}
	.friend-group h2 {
		font-size: 30px;
		font-weight: 700;
		line-height: 1.4211;
	}
	.friend-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px 16px;
		max-width: 1000px;
		margin-inline: auto;
	}
	.friend-card {
		position: relative;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius-large);
		background: var(--color-background-secondary);
	}
	.friend-card:hover {
		background: var(--color-background-secondary-hover);
	}
	.friend-main {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 12px;
		min-height: 112px;
		padding: 18px 48px 18px 18px;
		color: var(--color-text-primary);
		text-decoration: none;
	}
	.friend-main:focus-visible {
		border-radius: var(--radius-large);
		outline-offset: -3px;
	}
	.friend-avatar {
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		overflow: hidden;
		border-radius: 50%;
		background: var(--color-background-secondary-hover);
		color: var(--color-text-secondary);
		font-weight: 700;
	}
	.friend-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.friend-copy {
		display: grid;
		align-content: start;
		min-width: 0;
	}
	.friend-copy strong {
		overflow: hidden;
		font-size: 24px;
		font-weight: 700;
		line-height: normal;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.friend-copy small {
		color: var(--color-text-secondary);
	}
	.friend-copy > span {
		display: -webkit-box;
		overflow: hidden;
		margin-top: 8px;
		color: var(--color-text-secondary);
		font-size: 17px;
		font-weight: 400;
		line-height: 1.4211;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}
	.friend-feed {
		position: absolute;
		top: 0.8rem;
		right: 0.8rem;
		display: grid;
		width: 2rem;
		height: 2rem;
		place-items: center;
		border-radius: 0.4rem;
		color: var(--color-text-secondary);
	}
	.friend-feed:hover {
		background: var(--color-background-secondary-hover);
		color: var(--color-text-accent);
	}
	@media (max-width: 1000px) {
		.friend-grid {
			max-width: 800px;
		}
	}
	@media (max-width: 800px) {
		.friend-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 600px) {
		.friend-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
