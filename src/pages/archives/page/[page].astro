---
import type { GetStaticPaths } from 'astro'
import ArchiveList from '../../../components/ArchiveList.astro'
import PageHeading from '../../../components/PageHeading.astro'
import Pagination from '../../../components/Pagination.astro'
import { ARCHIVE_PAGE_SIZE } from '../../../consts'
import Layout from '../../../layouts/Layout.astro'
import { getArticles } from '../../../utils/article'

export const getStaticPaths = (async ({ paginate }) => {
	const articles = await getArticles()
	return paginate(articles, { pageSize: ARCHIVE_PAGE_SIZE }).filter(
		item => Number(item.params.page) > 1,
	)
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<Layout
	title={`归档 · 第 ${page.currentPage} 页`}
	description="按发布时间浏览全部文章。"
>
	<div class="page-shell">
		<PageHeading title="归档" />
		<ArchiveList articles={page.data} />
		<Pagination
			current={page.currentPage}
			total={page.lastPage}
			basePath="/archives/"
		/>
	</div>
</Layout>
