---
import type { GetStaticPaths } from 'astro'
import type { ArticleEntry } from '../../../types/article'
import ArchiveList from '../../../components/ArchiveList.astro'
import PageHeading from '../../../components/PageHeading.astro'
import Pagination from '../../../components/Pagination.astro'
import { ARCHIVE_PAGE_SIZE } from '../../../consts'
import Layout from '../../../layouts/Layout.astro'
import { getArticles } from '../../../utils/article'
import { translate, translateWithValues } from '../../../utils/i18n'
import { paginate } from '../../../utils/pagination'

export const getStaticPaths = (async () => {
	const articles = await getArticles()
	const totalPages = Math.ceil(articles.length / ARCHIVE_PAGE_SIZE)
	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
		const page = paginate(articles, index + 2, ARCHIVE_PAGE_SIZE)
		return { params: { page: String(page.currentPage) }, props: { page } }
	})
}) satisfies GetStaticPaths

const { page } = Astro.props as {
	page: { items: ArticleEntry[]; currentPage: number; totalPages: number }
}
---

<Layout
	title={translateWithValues('page.pageNumber', {
		title: translate('page.archives'),
		page: page.currentPage,
	})}
	titleKey="page.pageNumber"
	titleValues={{ title: translate('page.archives'), page: page.currentPage }}
	description={translate('page.archivesDescription')}
	descriptionKey="page.archivesDescription"
>
	<div class="page-shell">
		<PageHeading title={translate('page.archives')} titleKey="page.archives" />
		<ArchiveList articles={page.items} />
		<Pagination
			current={page.currentPage}
			total={page.totalPages}
			basePath="/archives/"
		/>
	</div>
</Layout>
