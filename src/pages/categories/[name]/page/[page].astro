---
import type { GetStaticPaths } from 'astro'
import type { ArticleEntry } from '../../../../types/article'
import type { TaxonomySummary } from '../../../../types/taxonomy'
import TaxonomyArchive from '../../../../components/TaxonomyArchive.astro'
import { ARCHIVE_PAGE_SIZE } from '../../../../consts'
import { getArticles } from '../../../../utils/article'
import { paginate } from '../../../../utils/pagination'
import { getTaxonomySummaries } from '../../../../utils/taxonomy'

export const getStaticPaths = (async () => {
	const categories = getTaxonomySummaries(await getArticles(), 'categories')
	return categories.flatMap(category =>
		Array.from(
			{
				length: Math.max(0, Math.ceil(category.count / ARCHIVE_PAGE_SIZE) - 1),
			},
			(_, index) => ({
				params: { name: category.name, page: String(index + 2) },
				props: {
					category,
					page: paginate(category.articles, index + 2, ARCHIVE_PAGE_SIZE),
				},
			}),
		),
	)
}) satisfies GetStaticPaths

const { category, page } = Astro.props as {
	category: TaxonomySummary
	page: { items: ArticleEntry[]; currentPage: number; totalPages: number }
}
---

<TaxonomyArchive kind="categories" summary={category} page={page} />
