---
import PageHeading from '../../components/PageHeading.astro'
import TaxonomyIndex from '../../components/TaxonomyIndex.astro'
import Layout from '../../layouts/Layout.astro'
import { getArticles } from '../../utils/article'
import { translate } from '../../utils/i18n'
import { getTaxonomySummaries } from '../../utils/taxonomy'

const categories = getTaxonomySummaries(await getArticles(), 'categories')
---

<Layout
	title={translate('page.categories')}
	titleKey="page.categories"
	description={translate('page.categoriesDescription')}
	descriptionKey="page.categoriesDescription"
>
	<div class="page-shell">
		<PageHeading
			title={translate('page.categories')}
			titleKey="page.categories"
			containedOnMobile
		/>
		<TaxonomyIndex kind="categories" items={categories} />
	</div>
</Layout>
